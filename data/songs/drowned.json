  {"date": "2000-10-05", "venue": "Verizon Wireless Amphitheater", "city": "Irvine", "state": "CA", "gap": 10, "set": "2", "out": "->", "next": "NICU", "xprev": "Possum", "nb": 1},
  {"date": "2003-07-25", "venue": "Verizon Wireless Amphitheatre - Charlotte", "city": "Charlotte", "state": "NC", "gap": 32, "set": "2", "out": "->", "next": "Kung", "xprev": "Character Zero", "nb": 1},
  {"date": "2004-04-15", "venue": "Thomas & Mack Center", "city": "Las Vegas", "state": "NV", "gap": 16, "set": "2", "out": "->", "prev": "46 Days", "in": ">", "next": "Also Sprach Zarathustra", "nb": 1},
  {"date": "2004-06-20", "venue": "Saratoga Performing Arts Center", "city": "Saratoga Springs", "state": "NY", "gap": 6, "set": "1", "jamchart": true, "jam": "A high quality, multi-faceted jam with building intensity.  The later jam segment sounds somewhat like the jam portion of \"Kill Devil Falls,\" which wouldn't emerge for another 4 years.", "prev": "Poor Heart", "in": ">", "xnext": "Seven Below", "nb": 1},
  {"date": "2004-08-14", "venue": "Newport State Airport", "city": "Coventry", "state": "VT", "gap": 10, "set": "3", "jamchart": true, "jam": "Very raw in parts (at least Trey), but a serious piece of improvisation nonetheless.  At the 7 minute mark, the band gets very quiet and almost stops.  Trey plays solo for a stretch, and briefly addresses the crowd.  Around 12:30, the other band mates rejoin in a very upbeat and rocking jam that accelerates into near fury by 21:30.", "out": ">", "prev": "Guyute", "next": "Friday", "nb": 1},
  {"date": "2009-06-04", "venue": "Nikon at Jones Beach Theater", "city": "Wantagh", "state": "NY", "gap": 7, "set": "2", "out": ">", "prev": "Birds of a Feather", "next": "Meatstick", "nb": 1},
  {"date": "2009-06-19", "venue": "Verizon Wireless Music Center", "city": "Noblesville", "state": "IN", "gap": 10, "set": "2", "out": ">", "prev": "A Song I Heard the Ocean Sing", "in": ">", "next": "Twist", "nb": 1},
  {"date": "2009-07-31", "venue": "Red Rocks Amphitheatre", "city": "Morrison", "state": "CO", "gap": 4, "set": "2", "out": "->", "next": "Crosseyed and Painless", "xprev": "Split Open and Melt", "nb": 1},
  {"date": "2009-08-13", "venue": "Darien Lake Performing Arts Center", "city": "Darien Center", "state": "NY", "gap": 7, "set": "2", "jamchart": true, "jam": "Backed by an unbridled pulse from Mike and Fish, there's quite a bit of improvisation in this jam. Perhaps lacking the melodic grandeur of the \"Sally\" from the previous week, this is a quality exploration nonetheless.", "out": ">", "next": "Prince Caspian", "xprev": "Golgi Apparatus", "nb": 1},
  {"date": "2009-11-22", "venue": "War Memorial at Oncenter", "city": "Syracuse", "state": "NY", "gap": 10, "set": "2", "out": ">", "next": "Twist", "xprev": "Stash", "nb": 1},
  {"date": "2010-06-13", "venue": "Hersheypark Stadium", "city": "Hershey", "state": "PA", "gap": 16, "set": "2", "jamchart": true, "jam": "Fish and Mike propel this shorter, funky version along.  Nice work by all four, and restraint by Trey adds to the overall quality. This is really quite a good version.", "out": ">", "next": "Tweezer", "xprev": "Split Open and Melt", "nb": 1},
  {"date": "2010-06-20", "venue": "Saratoga Performing Arts Center", "city": "Saratoga Springs", "state": "NY", "gap": 5, "set": "2", "jamchart": true, "jam": "Nice jam that bounces along before slowing to a more spacious sentiment that sets up nicely for a transition into \"Swept Away/Steep.\"", "out": ">", "prev": "Wilson", "next": "Swept Away", "nb": 1},
  {"date": "2010-07-02", "venue": "Verizon Wireless Amphitheatre - Charlotte", "city": "Charlotte", "state": "NC", "gap": 8, "set": "2", "out": ">", "next": "46 Days", "xprev": "Chalk Dust Torture", "nb": 1},
  {"date": "2010-08-12", "venue": "Verizon Wireless Music Center", "city": "Noblesville", "state": "IN", "gap": 8, "set": "2", "jamchart": true, "jam": "Wide-ranging jam that shores up its Type I energy at first, reaching a blazing staccato peak around 7:55. Then the jam becomes more rhythmic, with Page's organ dominating the sound picture. The mood shifts toward the introspective, and before you know it \"Drowned\" has transformed into a gorgeously melodic and mellow seedbed out of which \"Waiting All Night\" will eventually emerge three years later.", "out": ">", "next": "Gotta Jibboo", "xprev": "Time Turns Elastic", "nb": 1},
