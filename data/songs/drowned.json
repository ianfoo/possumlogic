  {"date": "1997-12-03", "venue": "CoreStates Spectrum", "city": "Philadelphia", "state": "PA", "gap": 52, "set": "1", "jamchart": true, "jam": "Funkalicious!  Great up-tempo version that highlights the band's peaking cohesiveness and improvisational talent during the Fall 1997 run.", "prev": "My Soul", "next": "The Old Home Place", "nb": 1},
  {"date": "1997-12-11", "venue": "Rochester War Memorial", "city": "Rochester", "state": "NY", "gap": 5, "set": "2", "jamchart": true, "jam": "The jam keeps up a pretty good head of steam until about 12:00 when it settles into 9 minutes of high quality '97-style space funk/quiet bliss enhanced with delay effects. -> to \"Roses Are Free.\"", "out": "->", "next": "Roses Are Free", "xprev": "Rocky Top", "nb": 1},
  {"date": "1997-12-28", "venue": "USAir Arena", "city": "Landover", "state": "MD", "gap": 3, "set": "2", "out": ">", "prev": "Ghost", "in": ">", "next": "Scent of a Mule", "nb": 1},
  {"date": "1998-07-09", "venue": "Zeleste", "city": "Barcelona", "state": "Catalonia", "gap": 15, "set": "2", "jamchart": true, "jam": "Jam segment is blistering from the very start, and somehow the band maintains a ferocious intensity for about six minutes, after which the jam cools off into a rock groove, which coasts along for awhile (Fish on cowbell for a bit too), with Mike stepping up at times, and concludes admirably with a return to Drowned's chords, before the jam slows down and segues into Theme.", "out": "->", "next": "Theme from the Bottom", "xprev": "Hello My Baby", "nb": 1},
