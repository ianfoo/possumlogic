  {"date": "2013-07-17", "venue": "Verizon Wireless Amphitheatre at Encore Park", "city": "Alpharetta", "state": "GA", "gap": 8, "set": "2", "out": "->", "prev": "Punch You in the Eye", "in": ">", "next": "Water in the Sky", "nb": 1},
  {"date": "2013-10-26", "venue": "DCU Center", "city": "Worcester", "state": "MA", "gap": 22, "set": "2", "jamchart": true, "jam": "A quality multi-section jam emerges. A quiet spacey section breaks first, followed by punchy and rocking playing with an \"Oye Como Va\"-like vibe. From there, a nice dose of 3.0-style \"HOSE\" develops and > to \"Light.\"", "out": ">", "next": "Light", "xprev": "Character Zero", "nb": 1},
  {"date": "2014-10-22", "venue": "Santa Barbara Bowl", "city": "Santa Barbara", "state": "CA", "gap": 40, "set": "2", "jamchart": true, "jam": "First '14 version bears resemblance to several \"CDTs\" from Summer '14 which range widely, but never latch onto a consistent groove, although this ends in good dark terrain.", "out": ">", "next": "Theme from the Bottom", "xprev": "Walls of the Cave", "nb": 1},
