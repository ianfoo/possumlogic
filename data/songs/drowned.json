  {"date": "1998-08-07", "venue": "Walnut Creek Amphitheater", "city": "Raleigh", "state": "NC", "gap": 12, "set": "1", "prev": "Water in the Sky", "next": "Frankie Says", "nb": 1},
  {"date": "1998-11-02", "venue": "The \u201cE\u201d Center", "city": "West Valley City", "state": "UT", "gap": 15, "set": "1", "jamchart": true, "jam": "Shredfest.", "out": "->", "prev": "Tube", "in": "->", "next": "Jesus Just Left Chicago", "nb": 1},
  {"date": "1998-11-25", "venue": "Pepsi Arena", "city": "Albany", "state": "NY", "gap": 15, "set": "2", "out": "->", "prev": "Golgi Apparatus", "next": "Prince Caspian", "nb": 1},
  {"date": "1999-09-21", "venue": "Pima County Fairgrounds", "city": "Tucson", "state": "AZ", "gap": 41, "set": "1", "jamchart": true, "jam": "Huge, powerhouse version, featuring incendiary, Jimi-esque Trey, and pounding Page. More wall of sound than musical, the jam drones until, set off by some scattershot riffs, play cools to assume a remarkably chill, wavy groove, full-band improvisation suspended in sound somewhere between 99 and what would arrive circa 2000.", "prev": "Split Open and Melt", "next": "I Didn't Know", "nb": 1},
  {"date": "1999-12-12", "venue": "Hartford Civic Center", "city": "Hartford", "state": "CT", "gap": 23, "set": "2", "jamchart": true, "jam": "If you're looking for a good groove-based jam coming out of \"Drowned,\" this is a more dynamic, propulsive and multi-sectional option than Big Cypress. It's solid, not epic, but well worth checking out.", "out": ">", "next": "Prince Caspian", "xprev": "Chalk Dust Torture", "nb": 1},
  {"date": "1999-12-31", "venue": "Big Cypress Seminole Indian Reservation", "city": "Big Cypress", "state": "FL", "gap": 7, "set": "2", "out": "->", "prev": "My Soul", "next": "After Midnight", "nb": 1},
  {"date": "2000-06-29", "venue": "PNC Bank Arts Center", "city": "Holmdel", "state": "NJ", "gap": 20, "set": "1", "jamchart": true, "jam": "Great version with an upbeat, pulsing jam that morphs into a celebratory, \"Gin\"-on-steroids-like section that segues seamlessly into \"Rock And Roll.\"", "out": "->", "prev": "Limb By Limb", "next": "Rock and Roll", "nb": 1},
  {"date": "2000-07-11", "venue": "Deer Creek Music Center", "city": "Noblesville", "state": "IN", "gap": 9, "set": "1", "jamchart": true, "jam": "A very cool jam with great Fish and Mike in this upbeat, funky version that transitions into \"Chalkdust Torture Reprise.\"", "prev": "Uncle Pen", "next": "Chalk Dust Torture Reprise", "nb": 1},
  {"date": "2000-09-14", "venue": "Darien Lake Performing Arts Center", "city": "Darien Center", "state": "NY", "gap": 9, "set": "2", "jamchart": true, "jam": "Phenomenal masterpiece of improvisation that is largely Page, Mike and Fish directed. One of the more challenging jams to appreciate, it may take several listens to fully sink in. But it's well worth the effort to get your arms and head around this magnum opus that transitions (>) to \"Crosseyed And Painless.\"", "out": ">", "next": "Crosseyed and Painless", "xprev": "Jam", "nb": 1},
