 "performances": [
  {"date": "1995-10-31", "venue": "Rosemont Horizon", "city": "Rosemont", "state": "IL", "gap": null, "set": "2", "jamchart": true, "jam": "Debut as part of the 1995 musical costume, the Who's Quadrophenia.  Straight forward version with no extended jamming.", "note": "Phish debut; Dave Grippo on alto saxophone, Don Glasgo on trombone, Joey Sommerville on trumpet and Alan Parshley on French horn.", "prev": "Sea and Sand", "next": "Bell Boy", "nb": 1},
  {"date": "1995-12-31", "venue": "Madison Square Garden", "city": "New York", "state": "NY", "gap": 33, "set": "2", "jamchart": true, "jam": "A top highlight of this glorious and storied concert.  A careful listen reveals extended \"Fire On the Mountain\"-like jamming from Trey in the post-\"Drowned\" section, as well as a bona fide tease near the ending and -> into \"The Lizards.\"", "out": "->", "next": "The Lizards", "xprev": "Chalk Dust Torture", "nb": 1},
