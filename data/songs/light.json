  {"date": "2012-09-01", "venue": "Dick's Sporting Goods Park", "city": "Commerce City", "state": "CO", "gap": 2, "set": "2", "jamchart": true, "jam": "In football you often hear the phrase \"a tale of two halves\" and this certainly applies to the infamous \"Dick's Light.\" While the first half of the jam is wrought with pitch effects and a meandering flow, the second is pure fire. It is easily the most identified version in the song's history and worthy of great praise whether the first half lowers your opinion of its ordering in this list or not.", "prev": "Prince Caspian", "in": ">", "next": "Boogie On Reggae Woman", "nb": 1},
  {"date": "2012-12-31", "venue": "Madison Square Garden", "city": "New York", "state": "NY", "gap": 5, "set": "2", "out": ">", "prev": "Piper", "in": ">", "next": "Also Sprach Zarathustra", "nb": 1},
  {"date": "2013-07-05", "venue": "Saratoga Performing Arts Center", "city": "Saratoga Springs", "state": "NY", "gap": 2, "set": "2", "jamchart": true, "jam": "A chaotic atonal interlude from the standard jam gives way to a pulsating, reverberating major mode section that settles into a melodic space before -> to \"Mango.\"", "out": "->", "prev": "Energy", "in": ">", "next": "The Mango Song", "nb": 1},
  {"date": "2013-07-10", "venue": "PNC Bank Arts Center", "city": "Holmdel", "state": "NJ", "gap": 3, "set": "2", "out": ">", "prev": "Sand", "in": ">", "next": "Good Times Bad Times", "nb": 1},
  {"date": "2013-07-14", "venue": "Merriweather Post Pavilion", "city": "Columbia", "state": "MD", "gap": 3, "set": "2", "jamchart": true, "jam": "An amazing show of improvisation. Trey stays away from the whammy predominantly and the band engages in a stop/start jam that harkens back to the hey-hole-jams of the early 90's. Infectiously fun, and truly unlike any other version to date.", "out": "->", "prev": "Backwards Down the Number Line", "in": ">", "next": "Boogie On Reggae Woman", "nb": 1},
