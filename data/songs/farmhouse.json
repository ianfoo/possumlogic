  {"date": "1999-09-28", "venue": "Oak Mountain Amphitheatre", "city": "Pelham", "state": "AL", "gap": 3, "set": "2", "jamchart": true, "jam": "The jam here starts out strongly and improves from there. \"Rockstar\" Trey is on display in this excellent version, taking advantage of multiple opportunities to add shredding color with his uniquely '99 style and tone.", "nb": 1, "xprev": "Harry Hood", "next": "Heavy Things"},
