  {"date": "2009-08-13", "venue": "Darien Lake Performing Arts Center", "city": "Darien Center", "state": "NY", "gap": 10, "set": "1", "nb": 1, "prev": "Possum", "next": "Sugar Shack"},
  {"date": "2009-11-25", "venue": "Wachovia Center", "city": "Philadelphia", "state": "PA", "gap": 12, "set": "2", "out": ">", "nb": 1, "prev": "Birds of a Feather", "next": "Tweezer"},
  {"date": "2010-06-17", "venue": "The Comcast Theatre", "city": "Hartford", "state": "CT", "gap": 16, "set": "2", "jamchart": true, "jam": "This version has an excellent jam segment most notable for the cohesive playing by all four band mates. The peaceful, wandering melody here creates a perfect soundtrack for a summer evening. The only drawback to this fine version is Trey's use of the pitch shifter, common throughout 2010, which can be grating if allowed to dominate one's listening experience.", "nb": 1, "prev": "Guyute", "next": "Mike's Song"},
  {"date": "2010-08-15", "venue": "Alpine Valley Music Theatre", "city": "East Troy", "state": "WI", "gap": 22, "set": "1", "nb": 1, "prev": "The Moma Dance", "in": ">", "next": "David Bowie"},
  {"date": "2010-12-27", "venue": "DCU Center", "city": "Worcester", "state": "MA", "gap": 18, "set": "2", "nb": 1, "prev": "Weekapaug Groove", "next": "Seven Below"},
  {"date": "2011-08-05", "venue": "Gorge Amphitheatre", "city": "George", "state": "WA", "gap": 26, "set": "2", "out": ">", "nb": 1, "prev": "Boogie On Reggae Woman", "in": ">", "next": "Show of Life"},
  {"date": "2011-12-31", "venue": "Madison Square Garden", "city": "New York", "state": "NY", "gap": 16, "set": "1", "nb": 1, "prev": "Gotta Jibboo", "next": "Pebbles and Marbles"},
  {"date": "2012-07-01", "venue": "Alpine Valley Music Theatre", "city": "East Troy", "state": "WI", "gap": 15, "set": "2", "jamchart": true, "jam": "Very 3.0-styled jam with peaceful, swinging melodic leads. Everything is subdued and nuanced, and it's just as easy to hear each of the players' respective contributions as it is to hear the unified end result.", "nb": 1, "prev": "Back on the Train", "in": ">", "next": "46 Days"},
  {"date": "2012-08-31", "venue": "Dick's Sporting Goods Park", "city": "Commerce City", "state": "CO", "gap": 16, "set": "2", "jamchart": true, "jam": "Both sections of this historic version from the \"F-Y-F\" show deserve your attention. \"Farmhouse\" proper has an excellent straightforward jam, including rocking play similar to the 2/24/03 version, and an extended sustained note from Trey akin to what one might hear in a \"Slave\" or \"Hood\" jam. The ambient outro jam begins with an introspective sentiment before morphing into techno-rock abstraction.", "out": ">", "nb": 1, "prev": "Runaway Jim", "in": ">", "next": "Alaska"},
  {"date": "2013-08-02", "venue": "Bill Graham Civic Auditorium", "city": "San Francisco", "state": "CA", "gap": 25, "set": "2", "jamchart": true, "jam": "Arguably the finest straightforward version to date, this wonderful version is replete with all sorts of good stuff, including fantastic playing by Mike, great Page and Trey counterpoint, and a lush groove with a peaceful and upbeat sense.", "out": ">", "nb": 1, "prev": "Prince Caspian", "in": ">", "next": "Seven Below"},
  {"date": "2014-07-03", "venue": "Saratoga Performing Arts Center", "city": "Saratoga Springs", "state": "NY", "gap": 26, "set": "1", "nb": 1, "first": 1, "next": "Wolfman's Brother"},
  {"date": "2014-10-17", "venue": "Matthew Knight Arena", "city": "Eugene", "state": "OR", "gap": 24, "set": "2", "nb": 1, "prev": "Plasma", "next": "Halfway to the Moon"},
  {"date": "2015-07-22", "venue": "Les Schwab Amphitheater", "city": "Bend", "state": "OR", "gap": 17, "set": "2", "jamchart": true, "jam": "Trey's tone and chording give this solid version a slightly edgy, more rock-oriented feel than the typical \"ballad\" type version. Apprearing mid 2nd set before an excellent \"Simple,\", it's not so much a \"breather\" song as a rocking downshift before revving up for what followed.", "out": ">", "nb": 1, "prev": "Wingsuit", "next": "Simple"},
  {"date": "2015-07-31", "venue": "Aaron's Amphitheatre at Lakewood", "city": "Atlanta", "state": "GA", "gap": 5, "set": "e", "out": ">", "nb": 1, "xprev": "Bathtub Gin", "next": "Character Zero"},
