  {"date": "2000-06-23", "venue": "Lakewood Amphitheatre", "city": "Atlanta", "state": "GA", "gap": 3, "set": "1", "jamchart": true, "jam": "A classic '00 version in every sense, this \"Farmhouse\" serves as a foil for the 9/28/99 version, and features a much more mellow, restrained yet interesting jam including some cool repetitive riffs from Trey near the conclusion.", "nb": 1, "prev": "Cars Trucks Buses", "xnext": "Rock and Roll"},
  {"date": "2000-06-30", "venue": "Meadows Music Theatre", "city": "Hartford", "state": "CT", "gap": 5, "set": "2", "out": ">", "nb": 1, "prev": "Makisupa Policeman", "next": "Sleeping Monkey"},
  {"date": "2000-07-04", "venue": "E Centre", "city": "Camden", "state": "NJ", "gap": 3, "set": "1", "nb": 1, "prev": "The Star-Spangled Banner", "next": "Rift"},
