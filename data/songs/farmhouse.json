  {"date": "2003-02-24", "venue": "Continental Airlines Arena", "city": "East Rutherford", "state": "NJ", "gap": 35, "set": "e", "jamchart": true, "jam": "This strong 2.0 version features great Fish and Trey teaming, some nice licks from Trey, and a cool fakeout ending of sorts. 2.0 doubters should give this surprising encore selection a spin to cleanse their senses.", "nb": 1, "xprev": "Chalk Dust Torture", "last": 1},
