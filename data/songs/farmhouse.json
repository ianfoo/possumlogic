  {"date": "2016-01-17", "venue": "Barcel\u00f3 Maya Beach", "city": "Riviera Maya", "state": "Quintana Roo", "gap": 4, "set": "2", "out": ">", "nb": 1, "prev": "Crosseyed and Painless", "in": ">", "next": "Mike's Song"},
  {"date": "2016-06-29", "venue": "The Mann Center for the Performing Arts", "city": "Philadelphia", "state": "PA", "gap": 6, "set": "1", "jamchart": true, "jam": "A sea of trills and melodic waves evoking the ocean's ebb and flow. A harmonious jam where the means are the ends; the musical equivalent to taking a walk through the woods for the sake of walking through the woods.", "out": ">", "nb": 1, "prev": "Horn", "in": ">", "next": "Weekapaug Groove"},
