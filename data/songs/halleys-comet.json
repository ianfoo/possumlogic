  {"date": "1995-06-24", "venue": "The Mann Center for the Performing Arts", "city": "Philadelphia", "state": "PA", "gap": 2, "set": "2", "out": ">", "prev": "Also Sprach Zarathustra", "in": ">", "next": "David Bowie", "nb": 1},
  {"date": "1995-07-02", "venue": "Summerstage at Sugarbush North", "city": "Fayston", "state": "VT", "gap": 6, "set": "e", "out": ">", "next": "Tweezer Reprise", "xprev": "Slave to the Traffic Light", "nb": 1},
  {"date": "1995-12-01", "venue": "Hersheypark Arena", "city": "Hershey", "state": "PA", "gap": 42, "set": "2", "out": ">", "next": "Mike's Song", "xprev": "Cavern", "nb": 1},
  {"date": "1995-12-14", "venue": "Broome County Veterans Memorial Arena", "city": "Binghamton", "state": "NY", "gap": 8, "set": "2", "jamchart": true, "jam": "The first truly jammed-out version. Following the typical outro jam, the band breaks into an upbeat melodic groove. The pulse quickens, then settles into an eerie, on-off style jam. Fantastic segue into a stellar version of &quot;NICU.&quot;", "out": "->", "prev": "Keyboard Army", "next": "NICU", "nb": 1},
  {"date": "1996-08-05", "venue": "Red Rocks Amphitheatre", "city": "Morrison", "state": "CO", "gap": 29, "set": "2", "jamchart": true, "jam": "The band rocks out the typical outro jam a little longer than usual, then Page cranks up the theremin for &quot;Somewhere Over The Rainbow.&quot;", "prev": "It's Ice", "next": "Over the Rainbow", "nb": 1},
  {"date": "1996-08-16", "venue": "Plattsburgh Air Force Base", "city": "Plattsburgh", "state": "NY", "gap": 6, "set": "1", "out": ">", "prev": "Divided Sky", "next": "David Bowie", "nb": 1},
  {"date": "1997-08-16", "venue": "Loring Commerce Centre", "city": "Limestone", "state": "ME", "gap": 91, "set": "3", "jamchart": true, "jam": "A kind of grunge-like jam develops, with additional vocal refrain at about 10:00. The jam then departs &quot;Halley's&quot; altogether and develops into a swirly, minor key, bluesy Fish and Mike led exploration. &quot;On Your Way Down&quot; tease leads directly to a -&gt; to &quot;Cities.&quot;", "out": "->", "next": "Cities", "xprev": "Julius", "nb": 1},
  {"date": "1997-11-22", "venue": "Hampton Coliseum", "city": "Hampton", "state": "VA", "gap": 7, "set": "2", "jamchart": true, "jam": "Starting off in a funky, mellow groove, the jam gradually grows legs and momentum with excellent contributions from all four. At about 18:00, the jam downshifts to a more quiet, pensive sentiment with occasional flashes of powerful bass and percussion. A must-hear classic.", "out": ">", "next": "Tweezer", "xprev": "Izabella", "nb": 1},
  {"date": "1997-12-28", "venue": "USAir Arena", "city": "Landover", "state": "MD", "gap": 14, "set": "2", "jamchart": true, "jam": "A crisp, tight, high energy jam - the band is really locked in on this one. Shorter than some, but well worth the visit!", "out": ">", "prev": "Scent of a Mule", "next": "Slave to the Traffic Light", "nb": 1},
  {"date": "1998-04-03", "venue": "Nassau Veterans Memorial Coliseum", "city": "Uniondale", "state": "NY", "gap": 4, "set": "e", "out": ">", "prev": "Carini", "in": ">", "next": "Tweezer Reprise", "nb": 1},
  {"date": "1998-07-10", "venue": "Zeleste", "city": "Barcelona", "state": "Catalonia", "gap": 10, "set": "2", "jamchart": true, "jam": "One of the earlier examples of the groove-based jamming that would blossom in '99 and '00. Mike takes the lead and Trey and Page gradually build off this, including a nice &quot;First Tube&quot; tease. The jam winds down in ambient '98 space.", "next": "Roggae", "xprev": "Mike's Song", "nb": 1},
  {"date": "1998-07-20", "venue": "Ventura County Fairgrounds", "city": "Ventura", "state": "CA", "gap": 4, "set": "e", "jamchart": true, "jam": "In the encore slot, the band extends the jam out into a nice, upbeat groove, and finishes the show by gradually cycling down their instruments, leaving only a Digital Delay Loop whirling away.", "prev": "Hold Your Head Up", "last": 1, "nb": 1},
  {"date": "1998-08-03", "venue": "Deer Creek Music Center", "city": "Noblesville", "state": "IN", "gap": 9, "set": "1", "jamchart": true, "jam": "A &quot;Nancy&quot; double shot, with &quot;Halley's&quot; -&gt; &quot;I Didn't Know.&quot; A Mike and Fish led funky, percussive jam initially springs out. From there, at least 3 distinct movements develop in a masterful, wide-ranging opus which includes &quot;A Love Supreme&quot; tease from Page.", "out": ">", "prev": "Rhinoceros", "next": "I Didn't Know", "nb": 1},
  {"date": "1998-08-15", "venue": "Loring Commerce Centre", "city": "Limestone", "state": "ME", "gap": 6, "set": "e", "out": ">", "next": "Cavern", "xprev": "Loving Cup", "nb": 1},
  {"date": "1998-11-11", "venue": "Van Andel Arena", "city": "Grand Rapids", "state": "MI", "gap": 15, "set": "2", "jamchart": true, "jam": "Pretty high octane jam at first. Around 11:00, morphs into a snappy, funky phase. The energy builds as the jam regains momentum and space rage ensues. Jam abruptly segues to &quot;Simple.&quot;", "out": ">", "next": "Simple", "xprev": "Julius", "nb": 1},
  {"date": "1998-11-24", "venue": "New Haven Veterans Memorial Coliseum", "city": "New Haven", "state": "CT", "gap": 7, "set": "2", "out": ">", "prev": "Ghost", "in": ">", "next": "Tweezer", "nb": 1},
  {"date": "1999-07-13", "venue": "Tweeter Center", "city": "Mansfield", "state": "MA", "gap": 17, "set": "1", "jamchart": true, "jam": "Following the final refrain, the band immediately shifts into minor mode and a moderately dark groove. Shifts back to major mode for a more upbeat ending and -&gt; to &quot;Roses.&quot;", "out": "->", "prev": "The Curtain", "in": ">", "next": "Roses Are Free", "nb": 1},
  {"date": "1999-09-28", "venue": "Oak Mountain Amphitheatre", "city": "Pelham", "state": "AL", "gap": 27, "set": "e", "out": ">", "next": "Tweezer Reprise", "xprev": "You Enjoy Myself", "nb": 1},
  {"date": "1999-10-08", "venue": "Nassau Veterans Memorial Coliseum", "city": "Uniondale", "state": "NY", "gap": 6, "set": "2", "jamchart": true, "jam": "A propulsive and swirling jam develops with nice Page and Trey teaming. Eventually settles down into a quieter, serene, and cohesive mood.", "out": ">", "next": "Tweezer", "xprev": "Run Like an Antelope", "nb": 1},
  {"date": "1999-12-07", "venue": "Cumberland County Civic Center", "city": "Portland", "state": "ME", "gap": 6, "set": "1", "jamchart": true, "jam": "An excellent, rollicking, and very upbeat jam develops immediately. Quiets down slightly at about 16:00, but regains momentum and a different vibe around 20:30. At 24:10, the jam finally slows down, taking a blissful few minutes to transition to &quot;Coil.&quot; Includes a &quot;Gotta Jibboo&quot; tease.", "out": ">", "prev": "Nellie Kane", "next": "The Squirming Coil", "nb": 1},
  {"date": "1999-12-15", "venue": "MCI Center", "city": "Washington", "state": "DC", "gap": 5, "set": "2", "out": ">", "prev": "Reba", "next": "Suzy Greenberg", "nb": 1},
  {"date": "2000-06-30", "venue": "Meadows Music Theatre", "city": "Hartford", "state": "CT", "gap": 24, "set": "2", "jamchart": true, "jam": "Nice jam with good bass work from Mike that sounds similar to &quot;Sand.&quot; The energy level really picks up in the final few minutes as Trey kicks into high gear. &quot;Things That Make You Go Hmmm&quot; tease by Mike.", "out": ">", "next": "The Mango Song", "xprev": "Possum", "nb": 1},
  {"date": "2000-09-18", "venue": "Blossom Music Center", "city": "Cuyahoga Falls", "state": "OH", "gap": 19, "set": "2", "jamchart": true, "jam": "A raging rockfest loaded with liquid metallic sounds for most of this jam, before finally unwinding in the final minutes.", "prev": "McGrupp and the Watchful Hosemasters", "xnext": "Axilla", "nb": 1},
  {"date": "2000-09-23", "venue": "Allstate Arena", "city": "Rosemont", "state": "IL", "gap": 2, "set": "1", "jamchart": true, "jam": "Nice rocking vibe to the early part of this jam. Fish keeps the pulse nicely until the end when space overtakes rhythm.", "out": ">", "prev": "Frankenstein", "next": "Fee", "nb": 1},
  {"date": "2000-10-05", "venue": "Verizon Wireless Amphitheater", "city": "Irvine", "state": "CA", "gap": 7, "set": "2", "out": "->", "prev": "David Bowie", "next": "Walk Away", "nb": 1},
  {"date": "2003-02-24", "venue": "Continental Airlines Arena", "city": "East Rutherford", "state": "NJ", "gap": 13, "set": "2", "jamchart": true, "jam": "Starting at a slower tempo than most versions, this &quot;Halley's&quot; has a groovy swing to it, as well as a few sprinkles of a darker sentiment. Excellent dynamics modulation, with the energy rising and falling.", "out": ">", "next": "Harry Hood", "xprev": "Rock Me Baby", "nb": 1},
  {"date": "2003-07-13", "venue": "Gorge Amphitheatre", "city": "George", "state": "WA", "gap": 9, "set": "1", "note": "Mike on electric bagpipes.", "out": ">", "prev": "Round Room", "next": "Guyute", "nb": 1},
