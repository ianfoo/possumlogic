  {"date": "2000-06-09", "venue": "On Air East", "city": "Shibuya City", "state": "Tokyo", "gap": 2, "set": "2", "jamchart": true, "jam": "Ending jam segment stretches the limits of the basic jam with some nice rhythmic variation, but still stays \"in bounds.\"", "prev": "Bouncing Around the Room", "next": "The Squirming Coil", "nb": 1},
