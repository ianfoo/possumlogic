  {"date": "2016-07-19", "venue": "Bill Graham Civic Auditorium", "city": "San Francisco", "state": "CA", "gap": 32, "set": "2", "jamchart": true, "jam": "In addition to strong playing, this version distinguishes through the use of dynamics. The jam section starts off as a quiet and calm respite, before patiently climbing to a ferocious and breathtaking peak.", "prev": "Manteca", "in": "->", "next": "Fluffhead", "nb": 1},
