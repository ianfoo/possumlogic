  {"date": "1999-07-08", "venue": "GTE Virginia Beach Amphitheater", "city": "Virginia Beach", "state": "VA", "gap": 5, "set": "2", "jamchart": true, "jam": "At first a wide-ranging and quality \"BOAF\" jam, this version then moves beyond, breaking into a \"Days Between\" jam, and an excellent and extended \"If I Only Had A Brain\" jam with strange lyrics from Mike and Trey. One of the best \"Birds.\"", "note": "Strange lyrics from Mike and Trey, including an Uno reference.", "out": ">", "next": "Prince Caspian", "xprev": "Cavern", "nb": 1},
