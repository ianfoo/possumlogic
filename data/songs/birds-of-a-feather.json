  {"date": "2022-07-31", "venue": "Merriweather Post Pavilion", "city": "Columbia", "state": "MD", "gap": 8, "set": "2", "jamchart": true, "jam": "Drops in neatly > from \"Tweezer\" and produces a cool hybrid jam that rhythmically stays in \"BOAF\" territory but melodically departs for stretches before charging back for a proper finish.", "prev": "Tweezer", "in": ">", "next": "Joy", "nb": 1},
