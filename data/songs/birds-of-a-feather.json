  {"date": "2016-07-16", "venue": "Gorge Amphitheatre", "city": "George", "state": "WA", "gap": 3, "set": "2", "jamchart": true, "jam": "Combining reverb-heavy sounds with a very different take on the familiar theme, this jam sways from passage to passage with increasing intensity, until peaking with solid Page and Trey. Straightforward structurally, this unique rendering of the \"BOAF\" jam is classic Phish, reinventing older material.", "prev": "Carini", "in": ">", "next": "Wingsuit", "nb": 1},
