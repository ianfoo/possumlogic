  {"date": "2019-07-09", "venue": "Mohegan Sun Arena", "city": "Uncasville", "state": "CT", "gap": 6, "set": "2", "jamchart": true, "jam": "An absolutely stunning piece of psychedelic music, almost akin to free jazz at times, that touches on nearly every mood imaginable in Phish's improvisation and a few not imaginable in Phish's improvisation. Exceptionally deep and must-hear.", "prev": "The Final Hurrah", "next": "Ghost", "nb": 1},
  {"date": "2019-12-08", "venue": "North Charleston Coliseum", "city": "North Charleston", "state": "SC", "gap": 15, "set": "e", "prev": "Pebbles and Marbles", "next": "Izabella", "nb": 1},
  {"date": "2019-12-28", "venue": "Madison Square Garden", "city": "New York", "state": "NY", "gap": 1, "set": "2", "out": ">", "prev": "Everything's Right", "in": ">", "next": "Set Your Soul Free", "nb": 1},
  {"date": "2020-02-20", "venue": "Moon Palace", "city": "Cancun", "state": "Quintana Roo", "gap": 4, "set": "1", "jamchart": true, "jam": "Drifts out of the usual jam into a stark minor key jam at Mike's urging, builds up a thick synth-laden ambient fog like it's 1999 all over again, and then gently returns to the main theme. A good omen for the future of \"Beneath a Sea of Stars Part 1\"'s improvisational future.", "out": ">", "prev": "Cavern", "in": ">", "next": "Say It To Me S.A.N.T.O.S.", "nb": 1},
