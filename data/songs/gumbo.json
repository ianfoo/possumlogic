  {"date": "1997-07-29", "venue": "Desert Sky Pavilion", "city": "Phoenix", "state": "AZ", "gap": 34, "set": "1", "jamchart": true, "jam": "The first jammed out \"Gumbo\" features a funky jam with Trey laying it down on his wah pedal. The jam begins to get spacey while Trey starts high pitched noodling out of a which a 4 chord descending pattern (not MLB) develops, with some beautiful work by Page (which sadly doesn't last long).", "prev": "Beauty of My Dreams", "next": "Dirt", "nb": 1},
  {"date": "1997-08-08", "venue": "New World Music Theatre", "city": "Tinley Park", "state": "IL", "gap": 6, "set": "1", "jamchart": true, "jam": "Not a funk fest like most '97 \"Gumbos.\" Trey-led soloing over a funky groove leads to a more rock and roll jam with a repetitive riff from Trey.", "out": ">", "prev": "Cars Trucks Buses", "next": "The Lizards", "nb": 1},
  {"date": "1997-08-13", "venue": "Star Lake Amphitheatre", "city": "Burgettstown", "state": "PA", "gap": 4, "set": "1", "jamchart": true, "jam": "The longest version to date starts off with a loose funk groove that develops into an air tight polyrhythmic groove which Trey eventually starts to solo on top off before fading out into \"The Horse.\"", "out": "->", "prev": "Water in the Sky", "next": "The Horse", "nb": 1},
  {"date": "1997-11-14", "venue": "The \u201cE\u201d Center", "city": "West Valley City", "state": "UT", "gap": 5, "set": "1", "jamchart": true, "jam": "Quickly breaks down into a Mike-led \"cow funk\" jam, that eventually dissipates into quiet ambiance and delay loops. Welcome to Fall '97.", "out": ">", "prev": "Runaway Jim", "next": "Maze", "nb": 1},
  {"date": "1997-11-26", "venue": "Hartford Civic Center", "city": "Hartford", "state": "CT", "gap": 7, "set": "1", "jamchart": true, "jam": "Funky jam has nice interplay between band members. Stacatto-ey at times with some \"Manteca\" teases. At 8:00 Mike starts a theme that they play around with for a couple minutes before Trey takes over with a solo that leads into My Soul.", "out": ">", "prev": "Sparkle", "in": ">", "next": "My Soul", "nb": 1},
  {"date": "1997-12-03", "venue": "CoreStates Spectrum", "city": "Philadelphia", "state": "PA", "gap": 5, "set": "1", "jamchart": true, "jam": "A badass \"type II\" (and dark) groove develops before dissolving into space, out of which 2001 begins.", "out": ">", "prev": "The Old Home Place", "next": "Also Sprach Zarathustra", "nb": 1},
  {"date": "1998-07-17", "venue": "Gorge Amphitheatre", "city": "George", "state": "WA", "gap": 27, "set": "1", "jamchart": true, "jam": "Slow funk groove with \"Manteca\" teases. Last few minutes is funky Trey solo and it finishes off with one slow chord.", "prev": "Ya Mar", "next": "Divided Sky", "nb": 1},
  {"date": "1998-08-03", "venue": "Deer Creek Music Center", "city": "Noblesville", "state": "IN", "gap": 12, "set": "2", "jamchart": true, "jam": "Funky super groove with a lot of \"Manteca\" teases. Very melodic Trey before an awesome \"Manteca\" ending. Page rage throughout. One of the strongest versions ever.", "next": "Axilla", "xprev": "Character Zero", "nb": 1},
  {"date": "1998-08-15", "venue": "Loring Commerce Centre", "city": "Limestone", "state": "ME", "gap": 7, "set": "2", "jamchart": true, "jam": "\"Manteca\"-like jamming to start, then, slowly, a \"Tweezer Reprise\" jam develops, and once it peaks, it breaks down into a fun danceable jam with a nice segue into \"Sanity\".", "out": "->", "prev": "Reba", "next": "Sanity", "nb": 1},
  {"date": "1998-10-15", "venue": "The Fillmore", "city": "San Francisco", "state": "CA", "gap": 3, "set": "1", "jamchart": true, "jam": "An unusual \"Gumbo\" as the jam stays relatively close to the \"Gumbo\" theme other than an umptempo, melodic groove that they lock onto in the beginning.", "out": ">", "prev": "Wolfman's Brother", "next": "David Bowie", "nb": 1},
  {"date": "1998-11-11", "venue": "Van Andel Arena", "city": "Grand Rapids", "state": "MI", "gap": 13, "set": "1", "jamchart": true, "jam": "Jam starts off with some funky Clavinet work by Page before Trey sends the jam into an ambient soundscape with a loop. Slight build up at the end of the jam but doesn't get very far.", "prev": "Punch You in the Eye", "next": "If You Need a Fool", "nb": 1},
  {"date": "1998-11-19", "venue": "Lawrence Joel Veterans Memorial Coliseum", "city": "Winston-Salem", "state": "NC", "gap": 5, "set": "2", "jamchart": true, "jam": "\"Manteca\"-like grooving. 8 minutes in the jam slows down and leads to some weird noises, possibly involving a spaceship landing on stage.", "out": "->", "prev": "Frankie Says", "next": "Chalk Dust Torture", "nb": 1},
  {"date": "1998-11-28", "venue": "Worcester Centrum Centre", "city": "Worcester", "state": "MA", "gap": 6, "set": "1", "jamchart": true, "jam": "Unusually melodic and soulful soloing from Trey in the jam.", "next": "Tube", "first": 1, "nb": 1},
  {"date": "1999-07-03", "venue": "Lakewood Amphitheatre", "city": "Atlanta", "state": "GA", "gap": 8, "set": "1", "jamchart": true, "jam": "Funky groove, with nice interplay between Page and Trey.", "prev": "Chalk Dust Torture", "next": "Sparkle", "nb": 1},
  {"date": "1999-07-26", "venue": "Deer Creek Music Center", "city": "Noblesville", "state": "IN", "gap": 17, "set": "1", "jamchart": true, "jam": "Standard \"Gumbo\" jam breaks down into a nice ambient jam. Trey sets some loops with Page adding beautiful piano. Segues nicely into \"NICU.\"", "out": "->", "prev": "Sleep", "next": "NICU", "nb": 1},
  {"date": "1999-09-14", "venue": "Boise State University Pavilion", "city": "Boise", "state": "ID", "gap": 9, "set": "2", "jamchart": true, "jam": "\"Another One Bites the Dust\" jam leads to a funky groove that has a cool stop-on-a-dime ending.", "prev": "AC/DC Bag", "in": ">", "next": "Down with Disease", "nb": 1},
  {"date": "1999-10-01", "venue": "Hilton Coliseum", "city": "Ames", "state": "IA", "gap": 12, "set": "2", "jamchart": true, "jam": "Somewhat bluesy groove with a \"Can't Turn You Loose\" tease from Page. Big crescendo of noise near the end.", "out": ">", "prev": "Silent in the Morning", "in": ">", "next": "Mountains in the Mist", "nb": 1},
  {"date": "1999-12-13", "venue": "Providence Civic Center", "city": "Providence", "state": "RI", "gap": 17, "set": "1", "jamchart": true, "jam": "Thick swampy groove. Descending chord pattern in the middle of the jam, but not MLB.", "prev": "Cars Trucks Buses", "next": "The Moma Dance", "nb": 1},
  {"date": "2000-06-14", "venue": "Drum Logos", "city": "Chuo Ward", "state": "Fukuoka", "gap": 18, "set": "1", "jamchart": true, "jam": "Jam starts spacey before finding its groove. They ride it out before Mike picks up the pace with Fish quickly responding. Trey plays some heavy rock and roll chords before they segue into \"Llama\".", "out": "->", "prev": "Cities", "next": "Llama", "nb": 1},
  {"date": "2000-07-07", "venue": "Star Lake Amphitheatre", "city": "Burgettstown", "state": "PA", "gap": 14, "set": "1", "jamchart": true, "jam": "Real tight groove, with no one member leading.", "prev": "Chalk Dust Torture", "next": "Divided Sky", "nb": 1},
  {"date": "2000-09-09", "venue": "Pepsi Arena", "city": "Albany", "state": "NY", "gap": 9, "set": "1", "jamchart": true, "jam": "Another very tight full-band groove.", "out": "->", "prev": "Jam", "in": ">", "next": "Maze", "nb": 1},
  {"date": "2000-09-27", "venue": "Fiddler's Green", "city": "Englewood", "state": "CO", "gap": 12, "set": "2", "jamchart": true, "jam": "Jam builds around the \"Gumbo\" riff before settling into a more subtle and subdued groove.", "out": ">", "prev": "Piper", "in": ">", "next": "Ghost", "nb": 1},
  {"date": "2003-07-22", "venue": "Verizon Wireless Music Center", "city": "Noblesville", "state": "IN", "gap": 35, "set": "1", "jamchart": true, "jam": "Dark monster of a jam. Goes between dark and uplifting segments. Some very nice playing from Trey throughout. Really shows off the strength of the 2.0 era.", "prev": "Beauty of My Dreams", "next": "Divided Sky", "nb": 1},
