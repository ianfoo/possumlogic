  {"date": "1989-12-08", "venue": "Withey Hall Dining Room, Green Mountain College", "city": "Poultney", "state": "VT", "gap": 26, "set": "2", "jamchart": true, "jam": "An unbelievable amount of tension and dissonance packed into a demented six-plus minutes of Phish.", "prev": "Tela", "in": ">", "next": "Slave to the Traffic Light", "nb": 1},
  {"date": "1990-06-16", "venue": "Townshend Family Park", "city": "Townshend", "state": "VT", "gap": 92, "set": "1", "jamchart": true, "jam": "Incredible Trey. And Page's keys lend added menace to this tense and harrowing early masterpiece. This Mule bites with a vengeance!", "out": ">", "prev": "Bouncing Around the Room", "next": "Lawn Boy", "nb": 1},
  {"date": "1990-11-28", "venue": "Clement's Brew Pub", "city": "Syracuse", "state": "NY", "gap": 50, "set": "e2", "xprev": "Rocky Top", "last": 1, "nb": 1},
  {"date": "1992-12-30", "venue": "Symphony Hall", "city": "Springfield", "state": "MA", "gap": 256, "set": "1", "jamchart": true, "jam": "-> in from \"David Bowie.\" The only performance between 1990 and 1995 is sandwiched inside a solid \"Bowie.\" This fine \"Timber\" packs the usual Trey shredding, great Fish and strong Page and Mike. > to \"Bowie.\"", "out": ">", "prev": "David Bowie", "in": "->", "next": "David Bowie", "nb": 1},
