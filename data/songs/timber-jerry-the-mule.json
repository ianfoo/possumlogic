  {"date": "1988-07-30", "venue": "The Roma", "city": "Telluride", "state": "CO", "gap": 5, "set": "3", "jamchart": true, "jam": "Band jams out in customary fashion, then breaks into a second, more upbeat jam coming out of the first groove. An excellent recording of this is available from LivePhish on the Colorado '88 release.", "prev": "Slave to the Traffic Light", "next": "Walk Away", "nb": 1},
  {"date": "1988-09-12", "venue": "Sam's Tavern", "city": "Burlington", "state": "VT", "gap": 19, "set": "2", "next": "Satin Doll", "xprev": "Bold As Love", "nb": 1},
