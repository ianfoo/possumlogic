  {"date": "2018-07-27", "venue": "The Forum", "city": "Inglewood", "state": "CA", "gap": 21, "set": "1", "out": ">", "prev": "Water in the Sky", "in": ">", "next": "Sand", "nb": 1},
  {"date": "2018-08-11", "venue": "Merriweather Post Pavilion", "city": "Columbia", "state": "MD", "gap": 9, "set": "e", "out": ">", "next": "Martian Monster", "xprev": "Slave to the Traffic Light", "nb": 1},
  {"date": "2018-10-16", "venue": "Times Union Center", "city": "Albany", "state": "NY", "gap": 5, "set": "2", "jamchart": true, "jam": "A sick and twisted, evil monster. At first, it sounds like the band is content to tinker with the basic song. But at about 8:00, Fish and Mike hook up and develop a high-power, pulsing and driving base. Chaos ensues, as spacey effects, unusual keyboards, and sick Mike create a throbbing, mind-blowing sensory assault.", "out": ">", "prev": "Piper", "in": ">", "next": "Show of Life", "nb": 1},
  {"date": "2019-06-21", "venue": "PNC Music Pavilion", "city": "Charlotte", "state": "NC", "gap": 27, "set": "2", "out": ">", "prev": "Taste", "next": "Possum", "nb": 1},
  {"date": "2019-06-30", "venue": "BB&T Pavilion", "city": "Camden", "state": "NJ", "gap": 7, "set": "2", "jamchart": true, "jam": "The band shows a willingness to let things develop slowly and organically at a level normally reserved for soundchecks in this relaxed, free-form exploration. Numerous styles and moods are employed with each movement given time to breathe before subtly transitioning to the next. From the initial grungy outro to floating bliss to the final funky riffing and everything in between, this jam covers a surprising amount of ground and does so without building to any singular peak.", "out": ">", "prev": "Mr. Completely", "in": ">", "next": "Big Black Furry Creature from Mars", "nb": 1},
  {"date": "2019-09-01", "venue": "Dick's Sporting Goods Park", "city": "Commerce City", "state": "CO", "gap": 12, "set": "1", "out": ">", "prev": "My Friend, My Friend", "in": ">", "next": "Sparkle", "nb": 1},
  {"date": "2019-12-01", "venue": "Nassau Veterans Memorial Coliseum", "city": "Uniondale", "state": "NY", "gap": 3, "set": "2", "jamchart": true, "jam": "> from \"Ruby Waves.\" This is a dark, swirling, Mike-led jam that wastes no time getting started once the song proper ends. Page and Fish create an ambient background while Trey and Mike interplay. The end of the jam gets quite heavy before dissolving into > \"Backwards Down the Number Line.\"", "out": ">", "prev": "Ruby Waves", "in": ">", "next": "Backwards Down the Number Line", "nb": 1},
  {"date": "2019-12-28", "venue": "Madison Square Garden", "city": "New York", "state": "NY", "gap": 6, "set": "1", "out": ">", "prev": "Dog Faced Boy", "next": "Tube", "nb": 1},
