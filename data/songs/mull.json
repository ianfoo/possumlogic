  {"date": "2023-10-07", "venue": "Bridgestone Arena", "city": "Nashville", "state": "TN", "gap": 7, "set": "1", "times": 2, "jamchart": true, "jam": "Great \"Mull,\" with more than a few \"Destiny Unbound\" undertones. Jamming breaks for a bit of \"2001,\" a callback to the show's strong show-opener, before > back to \"Mull.\"", "out": "->", "prev": "Beauty of My Dreams", "next": "Also Sprach Zarathustra", "nb": 1},
