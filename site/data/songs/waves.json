  {"date": "2003-08-02", "venue": "Loring Commerce Centre", "city": "Limestone", "state": "ME", "gap": 4, "set": "2", "jamchart": true, "jam": "After Waves ends, an improvisation bearing no relation to Waves begins, that dissolves into ~10 minutes of haunting, pulsing space that is mesmerizing. A soundscape more than music that, when combined with Kuroda's lights, must have been other worldly.", "out": ">", "prev": "Discern", "next": "Jam", "nb": 1},
