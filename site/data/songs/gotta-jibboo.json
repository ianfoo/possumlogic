  {"date": "1999-12-02", "venue": "The Palace of Auburn Hills", "city": "Auburn Hills", "state": "MI", "gap": 1, "set": "2", "prev": "Boogie On Reggae Woman", "next": "Bathtub Gin", "nb": 1},
  {"date": "1999-12-05", "venue": "BlueCross Arena", "city": "Rochester", "state": "NY", "gap": 3, "set": "1", "jamchart": true, "jam": "A strong, prototypical '99 \"Gotta Jibboo,\" with patient and careful Trey/Page interplay at first, a smooth and linear - but predictable - build up in energy and tension, and culmination in an intense, if somewhat short peak. One of the strongest standard '99 \"Jibboos.\"", "prev": "Carini", "in": ">", "next": "Back on the Train", "nb": 1},
  {"date": "1999-12-10", "venue": "First Union Spectrum", "city": "Philadelphia", "state": "PA", "gap": 3, "set": "2", "jamchart": true, "jam": "Careful and patient, the front half of this jam features strong Rhodes and synth work from Page, to create a twinkly and spacey vibe. The band slowly accelerates this \"Gotta Jibboo\" to a smooth pinnacle, with multiple, very pleasant peaks; other \"Jibboos\" peak harder, but this one peaks cleaner and longer than its '99 peers. A true culmination of groove-based jam ideas from fall and winter '99.", "next": "The Wedge", "xprev": "Loving Cup", "nb": 1},
  {"date": "1999-12-13", "venue": "Providence Civic Center", "city": "Providence", "state": "RI", "gap": 3, "set": "2", "out": ">", "next": "NICU", "xprev": "Theme from the Bottom", "nb": 1},
