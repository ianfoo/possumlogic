  {"date": "1999-09-18", "venue": "Coors Amphitheatre", "city": "Chula Vista", "state": "CA", "gap": 13, "set": "2", "jamchart": true, "jam": "The intial funky jam seems to be coming to an end at 9 minutes, but the jam picks back up and grooves for a few more minutes while Trey plays lead before the jam shifts to soaring, melodic &quot;hose&quot;. Returns to &quot;Boogie&quot; with breakdown solos from Mike, Trey, and Page. Must-hear.", "nb": 1, "xprev": "Rocky Top", "next": "Meatstick"},
