  {"date": "2000-07-07", "venue": "Star Lake Amphitheatre", "city": "Burgettstown", "state": "PA", "gap": 3, "set": "2", "out": ">", "prev": "Split Open and Melt", "next": "Mike's Song", "nb": 1},
  {"date": "2000-09-09", "venue": "Pepsi Arena", "city": "Albany", "state": "NY", "gap": 8, "set": "1", "jamchart": true, "jam": "Great Mike and Page in a version that opens up the jam section to interpretation rather than static melodic repetition.", "prev": "Boogie On Reggae Woman", "next": "Guyute", "nb": 1},
  {"date": "2000-09-24", "venue": "Target Center", "city": "Minneapolis", "state": "MN", "gap": 9, "set": "1", "prev": "Divided Sky", "next": "First Tube", "nb": 1},
  {"date": "2000-09-30", "venue": "Thomas & Mack Center", "city": "Las Vegas", "state": "NV", "gap": 3, "set": "1", "jamchart": true, "jam": "A more ranging and interesting jam than any performed up until this date. It's also blissfully serene and delicate. All performances after these September '00 versions would feature much greater variation in the jam.", "prev": "Maze", "next": "I Didn't Know", "nb": 1},
  {"date": "2003-01-04", "venue": "Hampton Coliseum", "city": "Hampton", "state": "VA", "gap": 8, "set": "1", "jamchart": true, "jam": "Outstanding version combines exceptional Trey soloing, strong Page/Trey back-and-forth, and excellent dynamics modulation driven by Fish and Mike. This one will make you weep with joy.", "prev": "Boogie On Reggae Woman", "next": "Maze", "nb": 1},
  {"date": "2003-02-26", "venue": "Worcester Centrum Centre", "city": "Worcester", "state": "MA", "gap": 9, "set": "1", "jamchart": true, "jam": "Fantastic version similar to a standout \"Taste\" or \"LxL\" with great Page/Trey interplay, and Mike is also great. Their collective restraint and nimble precision, really full-on musicianship, make this a jam of beauty.", "prev": "Clone", "next": "Drifting", "nb": 1},
  {"date": "2003-07-18", "venue": "Alpine Valley Music Theatre", "city": "East Troy", "state": "WI", "gap": 10, "set": "1", "jamchart": true, "jam": "Another great version, but vastly different from the preceding two. This is much more of a high power, rocking jam.", "prev": "The Mango Song", "next": "Discern", "nb": 1},
  {"date": "2004-04-15", "venue": "Thomas & Mack Center", "city": "Las Vegas", "state": "NV", "gap": 20, "set": "1", "jamchart": true, "jam": "The jam starts off in very fine fashion, with a cool and different groove, but then veers increasingly toward chaotic dissonance. This darker sentiment is underscored by Page who shifts his harmonic underpinnings to minor mode.", "prev": "The Old Home Place", "next": "Water in the Sky", "nb": 1},
  {"date": "2009-12-28", "venue": "American Airlines Arena", "city": "Miami", "state": "FL", "gap": 63, "set": "1", "prev": "My Soul", "next": "Undermind", "nb": 1},
  {"date": "2010-06-20", "venue": "Saratoga Performing Arts Center", "city": "Saratoga Springs", "state": "NY", "gap": 10, "set": "1", "prev": "Gotta Jibboo", "next": "Sleep Again", "nb": 1},
  {"date": "2010-08-12", "venue": "Verizon Wireless Music Center", "city": "Noblesville", "state": "IN", "gap": 15, "set": "1", "jamchart": true, "jam": "Very good, upbeat and crescendo oriented jam section.", "prev": "Punch You in the Eye", "next": "Cars Trucks Buses", "nb": 1},
  {"date": "2010-10-24", "venue": "Mullins Center, University of Massachusetts", "city": "Amherst", "state": "MA", "gap": 15, "set": "2", "out": "->", "prev": "Brother", "next": "Taste", "nb": 1},
  {"date": "2010-12-27", "venue": "DCU Center", "city": "Worcester", "state": "MA", "gap": 4, "set": "1", "jamchart": true, "jam": "Intense, somewhat dissonant jam provides a sharp stylistic contrast to the celebratory rendering from 8/12/10.", "prev": "Cool It Down", "next": "Heavy Things", "nb": 1},
  {"date": "2011-05-31", "venue": "PNC Bank Arts Center", "city": "Holmdel", "state": "NJ", "gap": 7, "set": "1", "out": ">", "prev": "Chalk Dust Torture", "next": "Punch You in the Eye", "nb": 1},
  {"date": "2011-08-05", "venue": "Gorge Amphitheatre", "city": "George", "state": "WA", "gap": 17, "set": "1", "jamchart": true, "jam": "After skirting around the periphery of \"Roggae,\" the jam eventually makes a clean break at about 7:30 into a somewhat rocking, somewhat bluesy jam with excellent Fish and Mike.", "out": ">", "prev": "Taste", "in": ">", "next": "Walk Away", "nb": 1},
  {"date": "2011-09-04", "venue": "Dick's Sporting Goods Park", "city": "Commerce City", "state": "CO", "gap": 10, "set": "2", "jamchart": true, "jam": "> in from an inspired \"Hood.\" A high powered, joyfully played jam continues the \"feel good\" from \"Hood.\" > to \"Ghost.\"", "out": ">", "prev": "Harry Hood", "in": ">", "next": "Ghost", "nb": 1},
  {"date": "2012-06-22", "venue": "Riverbend Music Center", "city": "Cincinnati", "state": "OH", "gap": 13, "set": "2", "prev": "Sand", "in": "->", "next": "Carini", "nb": 1},
  {"date": "2012-08-19", "venue": "Bill Graham Civic Auditorium", "city": "San Francisco", "state": "CA", "gap": 14, "set": "1", "jamchart": true, "jam": "Really a beautifully played and moving version from a great show.", "prev": "Gotta Jibboo", "in": ">", "next": "David Bowie", "nb": 1},
  {"date": "2013-08-02", "venue": "Bill Graham Civic Auditorium", "city": "San Francisco", "state": "CA", "gap": 31, "set": "1", "jamchart": true, "jam": "Another great \"Roggae\" from SF, with strong melodic and instrumental variation. Just wish they would play this more often.", "prev": "Vultures", "next": "Sand", "nb": 1},
  {"date": "2013-10-18", "venue": "Hampton Coliseum", "city": "Hampton", "state": "VA", "gap": 6, "set": "2", "jamchart": true, "jam": "The jam builds to a peak, seemingly to conclude, then settles briefly before rebuilding to a second peak.", "prev": "Free", "in": ">", "next": "Sparkle", "nb": 1},
  {"date": "2013-11-02", "venue": "Boardwalk Hall", "city": "Atlantic City", "state": "NJ", "gap": 10, "set": "2", "jamchart": true, "jam": "A delicate and beautifully played version with a dreamy quality to it, but which also builds to a powerful peak. > to \"Waves.\"", "out": ">", "prev": "Piper", "in": ">", "next": "Waves", "nb": 1},
  {"date": "2013-12-29", "venue": "Madison Square Garden", "city": "New York", "state": "NY", "gap": 1, "set": "1", "prev": "Rift", "next": "Sparkle", "nb": 1},
  {"date": "2014-07-03", "venue": "Saratoga Performing Arts Center", "city": "Saratoga Springs", "state": "NY", "gap": 5, "set": "1", "out": ">", "prev": "Mound", "in": ">", "next": "Possum", "nb": 1},
  {"date": "2014-07-19", "venue": "FirstMerit Bank Pavilion at Northerly Island", "city": "Chicago", "state": "IL", "gap": 10, "set": "1", "jamchart": true, "jam": "A stunning \"Type I\" version: Page teases \"Dirt,\" then Trey takes the helm joined by Mike, who adds some thunderous double-time riffs which Fish echoes, all leading to a great peak.", "prev": "Free", "in": ">", "next": "Heavy Things", "nb": 1},
  {"date": "2014-07-26", "venue": "Merriweather Post Pavilion", "city": "Columbia", "state": "MD", "gap": 2, "set": "1", "jamchart": true, "jam": "Another strong version, but this one is all about Trey, who deftly winds the melody and chords beautifully at the peak.", "prev": "Backwards Down the Number Line", "next": "The Wedge", "nb": 1},
  {"date": "2014-10-17", "venue": "Matthew Knight Arena", "city": "Eugene", "state": "OR", "gap": 9, "set": "1", "prev": "Reba", "next": "Simple", "nb": 1},
  {"date": "2014-11-01", "venue": "MGM Grand Garden Arena", "city": "Las Vegas", "state": "NV", "gap": 9, "set": "1", "prev": "Roses Are Free", "next": "Birds of a Feather", "nb": 1},
  {"date": "2015-01-02", "venue": "American Airlines Arena", "city": "Miami", "state": "FL", "gap": 3, "set": "1", "prev": "Possum", "next": "Stash", "nb": 1},
  {"date": "2015-07-25", "venue": "The Forum", "city": "Inglewood", "state": "CA", "gap": 4, "set": "2", "jamchart": true, "jam": "Trey, Page, and Mike weave in, out, and around each other harmoniously throughout this entire breathtaking jam, while Fish holds down the fort and leads them to a glorious peak. > \"BDTNL\" for CK5's birthday.", "out": ">", "prev": "My Friend, My Friend", "in": ">", "next": "Backwards Down the Number Line", "nb": 1},
  {"date": "2015-08-02", "venue": "Tuscaloosa Amphitheater", "city": "Tuscaloosa", "state": "AL", "gap": 4, "set": "1", "prev": "The Line", "next": "My Friend, My Friend", "nb": 1},
  {"date": "2015-08-15", "venue": "Merriweather Post Pavilion", "city": "Columbia", "state": "MD", "gap": 8, "set": "1", "jamchart": true, "jam": "Phish has certainly got \"Roggae\" dialed in at this point in time. This version is heartfelt, soulful, and beautifully played. Trey uses no effects, resulting in a natural sounding jam, and he picks his notes with impressive exactitude, resulting in a super tight, cleanly played version.", "out": ">", "prev": "McGrupp and the Watchful Hosemasters", "in": ">", "next": "Limb By Limb", "nb": 1},
