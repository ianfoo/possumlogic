  {"date": "2011-06-30", "venue": "Watkins Glen International", "city": "Watkins Glen", "state": "NY", "gap": null, "set": "1", "nb": 1, "prev": "Jam", "in": ">", "next": "Sleep Again"},
  {"date": "2011-08-15", "venue": "UIC Pavilion, University of Illinois", "city": "Chicago", "state": "IL", "gap": 18, "set": "2", "jamchart": true, "jam": "Sleek -&gt; from an extended &quot;Waves.&quot; The band launches into an upbeat, pulsing groove led by Mike, which ultimately unravels and dissolves into beatless ambience. What follows is a delicate and serene musical passage highlighted by Trey's emotional playing alongside Page's graceful Theremin work, both of which are phenomenal. -&gt; into &quot;Steam.&quot;", "note": "Page on theremin.", "out": "->", "nb": 1, "prev": "Waves", "in": "->", "next": "Steam"},
  {"date": "2012-06-20", "venue": "nTelos Pavilion", "city": "Portsmouth", "state": "VA", "gap": 18, "set": "1", "out": ">", "nb": 1, "prev": "Dog Log", "next": "Mike's Song"},
  {"date": "2012-08-28", "venue": "Chaifetz Arena, Saint Louis University", "city": "St. Louis", "state": "MO", "gap": 21, "set": "2", "jamchart": true, "jam": "Well crafted -&gt; from &quot;Frankie Says.&quot;  Quality &quot;Type I&quot; version features all the members in top form.  After the lyrical refrain, Fish loosens up the beat as Trey deploys syncopated loops, which -&gt; to &quot;Sand.&quot;", "out": "->", "nb": 1, "prev": "Frankie Says", "in": "->", "next": "Sand"},
  {"date": "2012-08-31", "venue": "Dick's Sporting Goods Park", "city": "Commerce City", "state": "CO", "gap": 2, "set": "1", "jamchart": true, "jam": "Outstanding and extremely cohesive &quot;Type II&quot; jam displays patience and purpose as each proceeding segment is developed and segued seemlessly into the next.  Mode shifts into bliss around 9:00 and a transcendent build commences with ever uplifting and growing power until peaking at 13:38. Quite an extraordinary &quot;U&quot; to round out the &quot;F-U-C-K Y-O-U&quot; set.", "nb": 1, "prev": "Ocelot", "xnext": "Runaway Jim"},
  {"date": "2013-07-22", "venue": "Molson Canadian Amphitheatre", "city": "Toronto", "state": "Ontario", "gap": 20, "set": "1", "nb": 1, "prev": "Chalk Dust Torture", "next": "Army of One"},
  {"date": "2013-07-27", "venue": "Gorge Amphitheatre", "city": "George", "state": "WA", "gap": 2, "set": "2", "jamchart": true, "jam": "Flawless -&gt; from &quot;Down With Disease.&quot;  The jam goes &quot;Type II&quot; around 6:15 and moves into melodic territory.  Featuring unique drumming from Fish, the band explores an open, loose segment that travels back and forth between quieter and more upbeat places before descending into dark ambience brewed up by Mike and his synth pedals.  Very nice  &gt; &quot;Light.&quot;", "note": "Fish on Marimba Lumina.", "out": ">", "nb": 1, "prev": "Down with Disease", "in": "->", "next": "Light"},
