  {"date": "2010-10-30", "venue": "Boardwalk Hall", "city": "Atlantic City", "state": "NJ", "gap": 29, "set": "1", "jamchart": true, "jam": "-&gt; from a notable &quot;Wolfman's Brother.&quot; Cohesive, full-band effort in this solid &quot;Type I&quot; version. &gt; to &quot;Bathtub Gin.&quot;", "out": ">", "nb": 1, "prev": "Wolfman's Brother", "in": "->", "next": "Bathtub Gin"},
