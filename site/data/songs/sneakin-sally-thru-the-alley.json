  {"date": "1997-12-30", "venue": "Madison Square Garden", "city": "New York", "state": "NY", "gap": 925, "set": "1", "times": 2, "jamchart": true, "jam": "First performance in 920 shows, opens first set of a highly regarded show. Nice '97 style funk/rock groove follows the lyrical section. A very unhurried, patient feel to this one. -> to \"Taste\", and is reprised and finished in the 4-part funk-fest encore.", "note": "No vocal jam.", "out": "->", "next": "Taste", "first": 1, "nb": 1},
  {"date": "1998-04-02", "venue": "Nassau Veterans Memorial Coliseum", "city": "Uniondale", "state": "NY", "gap": 2, "set": "2", "jamchart": true, "jam": "-> in from \"Wolfman's Brother.\" A heavy funk groove breaks out following the lyrical section with some great Fishman percussion. Great collective playing as the jam progresses and segues -> into \"Frankie Says.\"", "note": "No vocal jam.", "out": "->", "prev": "Wolfman's Brother", "in": "->", "next": "Frankie Says", "nb": 1},
  {"date": "1998-07-28", "venue": "Sandstone Amphitheatre", "city": "Bonner Springs", "state": "KS", "gap": 22, "set": "1", "jamchart": true, "jam": "Rocking bridge. A very subtle vocal jam can be heard from 5:33 - 6:55. A great rhythmic, \"Manteca\"-like jam continues following the (non) vocal jam.", "prev": "Tela", "in": ">", "next": "It's Ice", "nb": 1},
  {"date": "1998-08-08", "venue": "Merriweather Post Pavilion", "city": "Columbia", "state": "MD", "gap": 8, "set": "1", "jamchart": true, "jam": "A really great funky, but low key, jam emerges on the back end of \"Sally.\" -> to \"Guyute.\"", "note": "No vocal jam.", "out": "->", "prev": "NICU", "next": "Guyute", "nb": 1},
  {"date": "1998-10-31", "venue": "Thomas & Mack Center", "city": "Las Vegas", "state": "NV", "gap": 13, "set": "1", "jamchart": true, "jam": "Funky '98-style jam emerges, where Page on clavinet is the star. Rocks along until morphing into some more ambient, serene space, before a fantastic -> to \"CDT.\"", "note": "No vocal jam.", "out": "->", "prev": "Birds of a Feather", "next": "Chalk Dust Torture", "nb": 1},
  {"date": "1999-07-07", "venue": "Blockbuster Pavilion", "city": "Charlotte", "state": "NC", "gap": 28, "set": "1", "jamchart": true, "jam": "With a digital delay loop running in the background, Page and Fish crank up a nice rhythmic jam that grows very quiet in the final minutes before dissolving completely.", "note": "No vocal jam.", "prev": "My Mind's Got a Mind of its Own", "in": ">", "next": "Axilla", "nb": 1},
