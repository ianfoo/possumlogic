  {"date": "1991-11-08", "venue": "Ivory Tusk", "city": "Tuscaloosa", "state": "AL", "gap": 1, "set": "1", "jamchart": true, "jam": "The Wailing Banshee version. With &quot;Brother,&quot; more twisted and mind exploding = better.", "prev": "The Mango Song", "next": "Eliza", "nb": 1},
