  {"date": "1991-10-06", "venue": "Cochran Lounge, Student Union, Macalester College", "city": "St. Paul", "state": "MN", "gap": 2, "set": "1", "jamchart": true, "jam": "Although it starts off a little tamely, this version quickly kicks into gear with all the elements of great early versions - wild jamming, exotic texture, and dissonance with a capital &quot;D.&quot;", "prev": "The Man Who Stepped Into Yesterday", "next": "Hold Your Head Up", "nb": 1},
  {"date": "1991-10-10", "venue": "EMU Ballroom, University of Oregon", "city": "Eugene", "state": "OR", "gap": 1, "set": "2", "jamchart": true, "jam": "You can hear Trey say &quot;Hey Fish, let's really rock it&quot; right before they start this one. This is a classic with insanely nimble guitar playing, loads of shrill dissonance, and some mind bending, shrieking guitar effects.", "next": "Reba", "xprev": "Golgi Apparatus", "nb": 1},
  {"date": "1991-10-12", "venue": "Roseland Theater", "city": "Portland", "state": "OR", "gap": 2, "set": "2", "jamchart": true, "jam": "Artis the Spoonman as gueat artist. A very different &quot;Brother&quot; with Page taking the lead on organ, and some very cool percussion work from Fish and Artis the Spoonman on spoons. Trey is very restrained until the end when he cranks it up.", "note": "Artis the Spoonman.", "prev": "Dinner and a Movie", "in": ">", "next": "Hold Your Head Up", "nb": 1},
  {"date": "1991-10-15", "venue": "International Beer Garden", "city": "Arcata", "state": "CA", "gap": 2, "set": "2", "next": "Bouncing Around the Room", "xprev": "Rocky Top", "nb": 1},
