  {"date": "1991-11-12", "venue": "The Georgia Theatre", "city": "Athens", "state": "GA", "gap": 2, "set": "1", "jamchart": true, "jam": "In addition to the customary dissonance and sick playing by Trey, this version also includes lots of great Page on the B-3, and some excellent playing by Mike.", "out": ">", "prev": "Uncle Pen", "next": "Bouncing Around the Room", "nb": 1},
