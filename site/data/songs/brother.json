  {"date": "1992-04-17", "venue": "Warfield Theatre", "city": "San Francisco", "state": "CA", "gap": 7, "set": "2", "jamchart": true, "jam": "Page's brother appeared on stage in a bathtub for this second set opener. Sick Trey. Everyone excels in this version, but especially Fish. (timing is estimated because tape begins about 45 seconds into the song).", "next": "You Enjoy Myself", "xprev": "David Bowie", "nb": 1},
