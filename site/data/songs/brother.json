  {"date": "1996-10-31", "venue": "The Omni", "city": "Atlanta", "state": "GA", "gap": 5, "set": "3", "note": "Karl Perazzo on percussion.", "next": "Also Sprach Zarathustra", "xprev": "The Overload", "nb": 1},
  {"date": "1996-11-11", "venue": "Van Andel Arena", "city": "Grand Rapids", "state": "MI", "gap": 7, "set": "1", "prev": "Sparkle", "in": ">", "next": "Theme from the Bottom", "nb": 1},
  {"date": "1996-11-30", "venue": "ARCO Arena", "city": "Sacramento", "state": "CA", "gap": 12, "set": "2", "note": "Lyrics included reference to Steve McConnell.", "prev": "Glide", "next": "Contact", "nb": 1},
  {"date": "1998-04-04", "venue": "Providence Civic Center", "city": "Providence", "state": "RI", "gap": 89, "set": "2", "jamchart": true, "jam": "&gt; in from &quot;2001.&quot; About 4:38 into the conventional &quot;Brother,&quot; this one departs into a great, funky jam. Way beyond the standard, it nonetheless builds in tension and dissonance as the jam progresses. Includes a brief &quot;DEG&quot; tease.  After the song, the band played a brief &quot;radio friendly&quot; reprise.", "note": "With short instrumental reprise.", "prev": "Also Sprach Zarathustra", "in": ">", "next": "Ghost", "nb": 1},
  {"date": "1998-07-28", "venue": "Sandstone Amphitheatre", "city": "Bonner Springs", "state": "KS", "gap": 20, "set": "2", "jamchart": true, "jam": "&gt; in from &quot;Mango Song.&quot; Has a distinctly funky sound at first. Lots of great shredding by Trey. At about 4:50, breaks into a brief, funky, very non-&quot;Brother&quot; groove, then returns home to conclude.", "prev": "The Mango Song", "in": ">", "next": "Contact", "nb": 1},
  {"date": "2000-09-27", "venue": "Fiddler's Green", "city": "Englewood", "state": "CO", "gap": 155, "set": "2", "jamchart": true, "jam": "Almost exactly 9 years since its debut, this version harkens back to the old style of intense, chaotic, and electrified jamming. A little swirling '00-style sound manages to creep into the mix. Great Mike and a great version!", "prev": "Heavy Things", "next": "You Enjoy Myself", "nb": 1},
