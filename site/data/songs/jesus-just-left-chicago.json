  {"date": "1997-12-07", "venue": "Ervin J. Nutter Center, Wright State University", "city": "Dayton", "state": "OH", "gap": 13, "set": "1", "jamchart": true, "jam": "Fantastic -&gt; in from &quot;Psycho Killer.&quot; Played at a faster tempo, this one is more of a rocker and includes a &quot;Rocky Mountain Way&quot; tease.", "prev": "Psycho Killer", "in": "->", "next": "My Mind's Got a Mind of its Own", "nb": 1},
  {"date": "1998-07-19", "venue": "Shoreline Amphitheatre", "city": "Mountain View", "state": "CA", "gap": 25, "set": "2", "jamchart": true, "jam": "-&gt; in from &quot;Tweezer.&quot; More uptempo, less of a bluesy feel than many versions. Page jumps back and forth between the piano and organ, and plays both simultaneously at one point. Trey and the boys rock this one hard.", "prev": "Tweezer", "in": "->", "next": "McGrupp and the Watchful Hosemasters", "nb": 1},
