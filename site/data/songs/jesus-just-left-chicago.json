  {"date": "1997-03-01", "venue": "Markthalle", "city": "Hamburg", "state": "Hamburg", "gap": 5, "set": "1", "jamchart": true, "jam": "Great -&gt; in from &quot;Wolfman's Brother.&quot; Strong modulation of intensity in this stellar version. Huge peak at the end of Page's section is followed by near silent soloing by Trey, which gradually builds to a roaring, bluesy crescendo.", "prev": "Wolfman's Brother", "in": "->", "next": "Reba", "nb": 1},
