  {"date": "2016-09-02", "venue": "Dick's Sporting Goods Park", "city": "Commerce City", "state": "CO", "gap": 4, "set": "1", "jamchart": true, "jam": "Fiery pre-choral jamming oozes into a prolonged and focused jam zone throbbing with psychedelic intensity (an approach not yet taken through this point in the song's history).  Trey in particular is exuding a verve and tenacity wholly controlled, yet chaotic sonically.", "prev": "Ghost", "next": "Breath and Burning", "nb": 1},
