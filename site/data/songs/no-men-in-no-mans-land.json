  {"date": "2016-12-31", "venue": "Madison Square Garden", "city": "New York", "state": "NY", "gap": 6, "set": "3", "note": "James Casey on saxophone, Natalie Cressman on trombone and vocals, Jennifer Hartswick on trumpet and vocals, and Andres Forero on percussion.", "prev": "Suzy Greenberg", "next": "Breath and Burning", "nb": 1},
  {"date": "2017-01-15", "venue": "Barcel\u00f3 Maya Beach", "city": "Riviera Maya", "state": "Quintana Roo", "gap": 2, "set": "2", "out": ">", "prev": "Down with Disease", "in": "->", "next": "Sneakin' Sally Thru the Alley", "nb": 1},
  {"date": "2017-07-14", "venue": "Huntington Bank Pavilion at Northerly Island", "city": "Chicago", "state": "IL", "gap": 0, "set": "2", "jamchart": true, "jam": "Super version, which opens noticeably slower than 2016's fiery renditions. Trey augments his tone and solos with spirit, but the soul of this version arrives near the 8:00 mark, when Page moves to his synthesizer and leads the band through a spectral passage of \"postmodern,\" improvisational sound. Liquid bass and stylized Trey work atop Fish's minimalist beat, with Page working different sonic shifts that would sound at home in a mature \"IAWITW\" jam. Chanting and more focused guitar return this reading to the song's coda before a bit of space informs a > into \"Fuego.\"", "out": ">", "next": "Fuego", "xprev": "Blaze On", "nb": 1},
  {"date": "2017-08-04", "venue": "Madison Square Garden", "city": "New York", "state": "NY", "gap": 14, "set": "2", "out": ">", "prev": "Dem Bones", "next": "Everything In Its Right Place", "nb": 1},
  {"date": "2017-09-01", "venue": "Dick's Sporting Goods Park", "city": "Commerce City", "state": "CO", "gap": 2, "set": "2", "jamchart": true, "jam": "Awash in 2017's signature synth and Trey's latest effects, an example, here, of space down to a science. As Page explores his keyboards, Trey sheds the guitar and uses a new device to create a hushed, astral plane. Back on guitar, Trey guides the musicians, who together shape a celebratory peak.", "out": ">", "next": "Carini", "xprev": "More", "nb": 1},
  {"date": "2017-12-28", "venue": "Madison Square Garden", "city": "New York", "state": "NY", "gap": 2, "set": "2", "jamchart": true, "jam": "Quality NYE version. Drops down to minor key out of the verses as Trey switches on a gloopy effect and Page matches him on the synths, with Fish keeping the snappy \"NMINML\" beat. The jam grows more warm and upbeat, thanks to some really nifty electric piano work from Page and Mike stoking the mood, then melts away into gossamer-thin ambiance, albeit still pushed forward by Fish's insistent drumming. The tempo picks back up as Trey fires away with squealing notes and Page hammers the ivories, and they triumphantly return to the \"NMINML\" theme before the jam dies away and they make a neat effects-laden > into \"Twist\".", "out": ">", "prev": "Wilson", "in": ">", "next": "Twist", "nb": 1},
  {"date": "2018-07-17", "venue": "Lake Tahoe Outdoor Arena at Harveys", "city": "Stateline", "state": "NV", "gap": 3, "set": "2", "out": ">", "next": "Carini", "xprev": "Character Zero", "nb": 1},
  {"date": "2018-07-28", "venue": "The Forum", "city": "Inglewood", "state": "CA", "gap": 7, "set": "1", "out": ">", "prev": "Tide Turns", "next": "Bathtub Gin", "nb": 1},
