  {"date": "2022-08-03", "venue": "Pine Knob Music Theatre", "city": "Clarkston", "state": "MI", "gap": 4, "set": "1", "out": "->", "prev": "Carini", "in": ">", "next": "Twist", "nb": 1},
  {"date": "2022-08-06", "venue": "Atlantic City Beach", "city": "Atlantic City", "state": "NJ", "gap": 1, "set": "2", "jamchart": true, "jam": "After a delightfully melodic first jam, the band turns to explore the darker  realms of \"No Man's Land\" in a jam awash in loops and echoes that taps into a swirling and growling sonic space until finally resolving in a momentary bliss that decays only to give way to the opening notes of \"Tweezer\".", "out": ">", "next": "Tweezer", "xprev": "Moonage Daydream", "nb": 1},
  {"date": "2022-09-02", "venue": "Dick's Sporting Goods Park", "city": "Commerce City", "state": "CO", "gap": 6, "set": "1", "out": ">", "prev": "Weekapaug Groove", "in": "->", "next": "Weekapaug Groove", "nb": 1},
  {"date": "2022-12-30", "venue": "Madison Square Garden", "city": "New York", "state": "NY", "gap": 4, "set": "2", "jamchart": true, "jam": "Big set 2 opener that retains a steady, unhurried pace throughout. The band patiently books along, executing several modulations and subtle changes to the groove with Page and Trey's locked-in textural interplay standing out. The jam gradually builds in intensity, eventually arriving at an emphatic closing section full of energetic and dexterous Trey peaks.", "next": "Golden Age", "xprev": "Run Like an Antelope", "nb": 1},
