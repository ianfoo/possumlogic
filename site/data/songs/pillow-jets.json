  {"date": "2023-07-21", "venue": "The Pavilion at Star Lake", "city": "Burgettstown", "state": "PA", "gap": null, "set": "2", "jamchart": true, "jam": "Phish debut version downshifts after 6:00, becoming more moody and atmospheric before mounting another round of heavier rock which washes into > \"David Bowie\".", "note": "Phish debut.", "out": ">", "prev": "The Final Hurrah", "in": ">", "next": "David Bowie", "nb": 1},
