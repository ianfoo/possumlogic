  {"date": "2019-07-12", "venue": "Alpine Valley Music Theatre", "city": "East Troy", "state": "WI", "gap": 4, "set": "2", "out": ">", "prev": "Light", "in": ">", "next": "Light", "nb": 1},
  {"date": "2019-11-29", "venue": "Dunkin' Donuts Center", "city": "Providence", "state": "RI", "gap": 5, "set": "2", "times": 3, "jamchart": true, "jam": "Better late than never, \"Plasma\" now seems a Phish (centerpiece) staple.  Here, the band drops immediately from the song's signature licks to enter a synth-driven exploration, with major (or minor) \"Crosseyed and Painless\" undertones. Ever percussive, and, as always, interesting, a full-band psychedelic swirl peels apart as Trey shape shifts, his soloing brightening to inform, with Page's carnival-esque keys, a fun, celebratory vibe.", "note": "Ending only.", "out": ">", "prev": "Back on the Train", "in": ">", "next": "Farmhouse", "nb": 1},
