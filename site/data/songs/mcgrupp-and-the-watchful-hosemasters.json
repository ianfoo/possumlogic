  {"date": "1994-06-26", "venue": "Municipal Auditorium", "city": "Charleston", "state": "WV", "gap": 2, "set": "1", "out": ">", "nb": 1, "prev": "The Sloth", "in": ">", "next": "Divided Sky"},
  {"date": "1994-07-02", "venue": "Garden State Arts Center", "city": "Holmdel", "state": "NJ", "gap": 4, "set": "2", "jamchart": true, "jam": "The jam section begins with good energy, settles, then rebuilds with Trey, Mike, Fish and the audience contributing rhythmic support. Then there's a brief &quot;Landlady&quot;-like section before the tension mounts and finally breaks as the closing section begins.", "nb": 1, "prev": "Weekapaug Groove", "next": "Maze"},
