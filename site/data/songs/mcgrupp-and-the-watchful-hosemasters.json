 "performances": [
  {"date": "1985-04-06", "venue": "Finbar's", "city": "Burlington", "state": "VT", "gap": 14, "set": "2", "jamchart": true, "jam": "Debut. The lyrics are narrated by Trey, rather than sung, and Page had not yet joined the band. A fairly intense, mostly straightforward Jeff and Trey guitar jam follows the lyrical section. (Circulates as filler on 3/4/85 Hunt's).", "note": "First known performance. Narrated rather than sung.", "out": ">", "nb": 1, "xprev": "Run Like an Antelope", "next": "Makisupa Policeman"},
  {"date": "1985-05-03", "venue": "University of Vermont", "city": "Burlington", "state": "VT", "gap": 7, "set": "3", "jamchart": true, "jam": "-> in from \"Whipping Post.\" Again, the lyrics are narrated. Page sat in as a guest for this show, and he begins make his presence felt, adding color to the excellent, guitar-driven jam, which has moments that sound similar to \"Drowned\". Eventually getting back to \"McGrupp,\" this version slowly winds down with a > to \"Makisupa.\"", "out": ">", "nb": 1, "prev": "Whipping Post", "in": "->", "next": "Makisupa Policeman"},
  {"date": "1985-09-26", "venue": "WRUV Radio", "city": "Burlington", "state": "VT", "gap": null, "set": "1", "nb": 1, "prev": "Dave's Energy Guide", "last": 1},
  {"date": "1985-09-27", "venue": "Slade Hall, University of Vermont", "city": "Burlington", "state": "VT", "gap": 3, "set": "3", "out": ">", "nb": 1, "prev": "Dave's Energy Guide", "next": "Cities"},
  {"date": "1985-10-17", "venue": "Finbar's", "city": "Burlington", "state": "VT", "gap": 1, "set": "1", "jamchart": true, "jam": "The entire band breaks into a jam where Page would solo in later versions. Although the recording ends before the jamming section concludes, the nearly 5 minutes captured on tape give a good flavor for the open-ended nature of these early jams in \"McGrupp.\"", "nb": 1, "prev": "Run Like an Antelope", "last": 1},
  {"date": "1986-04-01", "venue": "Hunt's", "city": "Burlington", "state": "VT", "gap": 11, "set": "2", "jamchart": true, "jam": "Trey speaks the lyrics in a &quot;Dylan-esque&quot; manner, while the jam portion features a soaring Trey guitar solo.", "note": "Spoken in Dylan-esque fashion.", "out": ">", "nb": 1, "prev": "AC/DC Bag", "next": "Alumni Blues"},
  {"date": "1986-10-15", "venue": "Hunt's", "city": "Burlington", "state": "VT", "gap": 11, "set": "1", "jamchart": true, "jam": "Jeff has left the band at this point, and his departure is noticeable as Page plays a prominent role throughout (great recording too). The jam has an upbeat, Grateful Dead-like tone, and includes the whole band despite Page's leading role.", "nb": 1, "prev": "I Am Hydrogen", "in": ">", "next": "AC/DC Bag"},
  {"date": "1986-12-06", "venue": "The Ranch", "city": "Shelburne", "state": "VT", "gap": 6, "set": "2", "nb": 1, "prev": "Icculus", "next": "Good Times Bad Times"},
  {"date": "1987-04-29", "venue": "Nectar's", "city": "Burlington", "state": "VT", "gap": 12, "set": "3", "jamchart": true, "jam": "Another early version with a jam following the lyrics and composed sections. This one is quite rocking and has a great vibe to it.", "out": ">", "nb": 1, "prev": "Sparks", "in": ">", "next": "The Ballad of Curtis Loew"},
  {"date": "1987-08-09", "venue": "Nectar's", "city": "Burlington", "state": "VT", "gap": 6, "set": "3", "nb": 1, "prev": "Flat Fee", "next": "Corinna"},
  {"date": "1987-08-21", "venue": "Ian McLean's Farm", "city": "Hebron", "state": "NY", "gap": 2, "set": "3", "jamchart": true, "jam": "The first version with lyrics sung rather than narrated. The jam follows a similar pattern to others from this period, with Trey strumming quite a bit while Page rocks the keyboard, but this one grows increasingly intense before seeming to veer towards \"Possum.\" Instead, the jam explores more ground, then -> to \"Stir It Up Jam\" with no return to the typical closing.", "out": "->", "nb": 1, "prev": "Big Black Furry Creature from Mars", "next": "Stir It Up"},
  {"date": "1987-08-29", "venue": "The Ranch", "city": "South Burlington", "state": "VT", "gap": 2, "set": "2", "jamchart": true, "jam": "Nice rocking vibe to the jam, with Page and Trey sort of trading licks at moments. The jam keeps on rocking, with no return to the &quot;McGrupp&quot; closing, and neatly -&gt; to &quot;Possum.&quot;", "out": "->", "nb": 1, "prev": "The Curtain With", "next": "Possum"},
  {"date": "1987-10-14", "venue": "Hunt's", "city": "Burlington", "state": "VT", "gap": 9, "set": "2", "out": ">", "nb": 1, "prev": "Divided Sky", "in": ">", "next": "Clod"},
  {"date": "1987-10-31", "venue": "Sculpture Room, Goddard College", "city": "Plainfield", "state": "VT", "gap": 5, "set": "2", "out": ">", "nb": 1, "prev": "Divided Sky", "in": ">", "next": "Who Do? We Do!"},
  {"date": "1987-11-19", "venue": "Hunt's", "city": "Burlington", "state": "VT", "gap": 5, "set": "1", "jamchart": true, "jam": "First &quot;McGrupp&quot; to feature Page on the keyboards following the composed sections, rather than a whole band jam. Page's solo is dark and somewhat ominous, with nice background support from the others. Rather than return to close &quot;McGrupp&quot; formally, the jam continues and -&gt; to &quot;Sparks.&quot;", "out": "->", "nb": 1, "first": 1, "next": "Sparks"},
