  {"date": "2025-07-20", "venue": "United Center", "city": "Chicago", "state": "IL", "gap": 10, "set": "2", "prev": "Shine a Light", "in": ">", "xnext": "Fee", "nb": 1},
  {"date": "2025-07-27", "venue": "Broadview Stage at SPAC", "city": "Saratoga Springs", "state": "NY", "gap": 4, "set": "2", "jamchart": true, "jam": "Brisk play takes hold from the beginning, with Trey and Mike's interplay being particularly elevated and conversational. Play then breaks into dreamier territory, retaining an upbeat bent while shifting between major and minor key tonalities. The band then latches on to an infectious, driving theme that culminates in hose-y Trey peaks and a massive Mike bass bomb before > \"Twist\".", "note": "Unfinished.", "out": ">", "next": "Twist", "xprev": "Tweezer Reprise", "nb": 1},
