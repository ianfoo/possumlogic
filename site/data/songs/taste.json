  {"date": "1996-12-29", "venue": "CoreStates Spectrum", "city": "Philadelphia", "state": "PA", "gap": 4, "set": "1", "prev": "Cavern", "in": ">", "next": "Guelah Papyrus", "nb": 1},
  {"date": "1997-02-13", "venue": "Shepherd's Bush Empire", "city": "London", "state": "England", "gap": 3, "set": "1", "out": ">", "prev": "Walfredo", "next": "Waste", "nb": 1},
