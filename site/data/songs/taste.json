  {"date": "1996-11-30", "venue": "ARCO Arena", "city": "Sacramento", "state": "CA", "gap": 1, "set": "2", "jamchart": true, "jam": "Remarkable version which includes a unique slowed down intro and Peter Apfelbaum on tenor saxophone who takes over the soloing duties from Trey.", "note": "Peter Apfelbaum on tenor saxophone, slowed down intro", "prev": "Timber (Jerry the Mule)", "in": ">", "next": "Funky Bitch", "nb": 1},
