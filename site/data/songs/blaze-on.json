  {"date": "2016-09-03", "venue": "Dick's Sporting Goods Park", "city": "Commerce City", "state": "CO", "gap": 2, "set": "2", "jamchart": true, "jam": "For the second year in a row, \"Blaze On\" gets taken for a walk at Dick's. This year's jam has a more laid back, unhurried feel to it, with nice delay work by Trey that builds before segueing nicely into -> \"Simple.\"", "out": "->", "prev": "Sand", "in": ">", "next": "Simple", "nb": 1},
