  {"date": "1993-02-03", "venue": "Portland Expo", "city": "Portland", "state": "ME", "gap": null, "set": "1", "jamchart": true, "jam": "Strong debut version features a slinky and jazzy piano intro. Page solos nicely, with cool chords from Trey, who soon offers an energetic solo of his own. Page retakes control through an extended outro, which builds to a near peak. Must-hear for fans of \"The Wedge.\"", "note": "Debut.", "prev": "Llama", "next": "Divided Sky", "nb": 1},
  {"date": "1993-02-04", "venue": "Providence Performing Arts Center", "city": "Providence", "state": "RI", "gap": 1, "set": "2", "prev": "Chalk Dust Torture", "next": "Mike's Song", "nb": 1},
