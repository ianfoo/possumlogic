  {"date": "2023-02-26", "venue": "Moon Palace", "city": "Cancun", "state": "Quintana Roo", "gap": 7, "set": "1", "next": "David Bowie", "first": 1, "nb": 1},
  {"date": "2023-04-21", "venue": "Hollywood Bowl", "city": "Hollywood", "state": "CA", "gap": 6, "set": "1", "prev": "The Moma Dance", "in": ">", "next": "Party Time", "nb": 1},
  {"date": "2023-07-12", "venue": "Orion Amphitheater", "city": "Huntsville", "state": "AL", "gap": 4, "set": "1", "jamchart": true, "jam": "A gritty, sweaty take that bakes in southern heat before opening into a cooler sonic space that bubbles to a rolling peak and simmers to conclusion.", "out": ">", "prev": "Plasma", "in": ">", "next": "Wolfman's Brother", "nb": 1},
  {"date": "2023-07-21", "venue": "The Pavilion at Star Lake", "city": "Burgettstown", "state": "PA", "gap": 6, "set": "2", "jamchart": true, "jam": "All four members are right up front contributing creatively without hesitation, actively listening, remaining locked in and punchy with direction. An upbeat set 2 opener that segues neatly into \"The Final Hurrah\".", "out": "->", "next": "The Final Hurrah", "xprev": "Scents and Subtle Sounds", "nb": 1},
