  {"date": "2022-04-20", "venue": "Madison Square Garden", "city": "New York", "state": "NY", "gap": 4, "set": "2", "out": ">", "next": "Down with Disease", "xprev": "Blaze On", "nb": 1},
  {"date": "2022-05-28", "venue": "The Wharf Amphitheater", "city": "Orange Beach", "state": "AL", "gap": 5, "set": "1", "jamchart": true, "jam": "In a string of strong openers, Sigma Oasis gets the extended treatment for the second time. Soaring play from Trey kicks the jam off, which gives way to a breakdown jam. Mike is inventive and creative throughout.", "next": "Possum", "first": 1, "nb": 1},
  {"date": "2022-06-05", "venue": "Ruoff Music Center", "city": "Noblesville", "state": "IN", "gap": 6, "set": "2", "out": "->", "prev": "Sand", "next": "Sand", "nb": 1},
  {"date": "2022-07-16", "venue": "Maine Savings Amphitheater", "city": "Bangor", "state": "ME", "gap": 3, "set": "2", "times": 2, "out": ">", "next": "Down with Disease", "xprev": "Run Like an Antelope", "nb": 1},
  {"date": "2022-07-24", "venue": "Xfinity Theatre", "city": "Hartford", "state": "CT", "gap": 5, "set": "1", "jamchart": true, "jam": "Another strong entry in the early history of what has quickly become Phish's post-shutdown standard bearer, this dual peak version traverses blissful, melodic heights then contemplates subterranean spaces before reascending triumphantly.", "prev": "Plasma", "in": ">", "next": "Limb By Limb", "nb": 1},
  {"date": "2022-07-30", "venue": "Merriweather Post Pavilion", "city": "Columbia", "state": "MD", "gap": 4, "set": "2", "out": ">", "prev": "Fuego", "in": ">", "next": "Prince Caspian", "nb": 1},
  {"date": "2022-08-05", "venue": "Atlantic City Beach", "city": "Atlantic City", "state": "NJ", "gap": 4, "set": "1", "jamchart": true, "jam": "A multi-sectioned monstrosity emerges from the Atlantic City Beach. The jam begins in familiar, \nbut strong territory with excellent melodic interplay. The music grows deeper as Trey \nand Mike dip into their effects. Shortly after the 14 minute mark, Fishman blasts the band off into \nhyperspace via a double time tempo change. An aggressive and high energy jam follows, evocative of \n2.0 era \"Piper\"s. The band then cools down into a thick funk segment that -> \"Cities.\" Must hear.", "out": "->", "prev": "Back on the Train", "next": "Cities", "nb": 1},
  {"date": "2022-08-10", "venue": "Budweiser Stage", "city": "Toronto", "state": "Ontario", "gap": 3, "set": "1", "out": "->", "next": "Blaze On", "first": 1, "nb": 1},
