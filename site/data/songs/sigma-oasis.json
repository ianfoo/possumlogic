  {"date": "2021-09-05", "venue": "Dick's Sporting Goods Park", "city": "Commerce City", "state": "CO", "gap": 7, "set": "1", "jamchart": true, "jam": "\"Sigma Oasis\" makes its jam vehicle debut as the second half of a surprise first set 1-2 punch with \"Sand\", settling into a lower-key late-night groove reminiscent of the prior show's \"Everything's Right\" before morphing into something even more wicked thanks to Trey and Mike's effects and then slowly morphing into \"All of These Dreams\".", "out": ">", "prev": "Sand", "in": ">", "next": "All of These Dreams", "nb": 1},
