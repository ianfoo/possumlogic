  {"date": "1999-09-25", "venue": "Cynthia Woods Mitchell Pavilion", "city": "The Woodlands", "state": "TX", "gap": 2, "set": "1", "jamchart": true, "jam": "Nice extended jam that has a very quiet mid section, a great peak, and strong playing by Trey.", "nb": 1, "prev": "Horn", "next": "On Your Way Down"},
  {"date": "1999-10-01", "venue": "Hilton Coliseum", "city": "Ames", "state": "IA", "gap": 3, "set": "1", "nb": 1, "prev": "Heavy Things", "next": "Cavern"},
  {"date": "1999-10-04", "venue": "Redbird Arena, Illinois State University", "city": "Normal", "state": "IL", "gap": 2, "set": "1", "nb": 1, "prev": "Jesus Just Left Chicago", "next": "Wilson"},
  {"date": "1999-10-09", "venue": "Pepsi Arena", "city": "Albany", "state": "NY", "gap": 2, "set": "2", "jamchart": true, "jam": "Excellent version with strong playing. The jam hits usual peak indicating the song's finale - then at about 8:30 breaks into a low-key groove that works its way back to the \"Limb\" theme with a soaring peak.", "out": ">", "nb": 1, "xprev": "Possum", "next": "Also Sprach Zarathustra"},
  {"date": "1999-12-03", "venue": "Firstar Center", "city": "Cincinnati", "state": "OH", "gap": 2, "set": "2", "jamchart": true, "jam": "Departs from \"Limb\" proper around 8:00 and heads into a dark, subdued jam during which Trey plays keyboard for a good portion. Not to everyone's liking, but more exploratory than most versions. Returns to \"Limb\" to conclude.", "nb": 1, "prev": "Sand", "next": "Bug"},
  {"date": "1999-12-08", "venue": "Cumberland County Civic Center", "city": "Portland", "state": "ME", "gap": 3, "set": "1", "nb": 1, "first": 1, "next": "Back on the Train"},
  {"date": "1999-12-13", "venue": "Providence Civic Center", "city": "Providence", "state": "RI", "gap": 3, "set": "2", "jamchart": true, "jam": "Another exceptional version with solid playing by all, but especially Machine Gun Trey who rips a glorious peak.", "nb": 1, "prev": "Mountains in the Mist", "next": "Golgi Apparatus"},
  {"date": "1999-12-16", "venue": "Reynolds Coliseum", "city": "Raleigh", "state": "NC", "gap": 1, "set": "1", "jamchart": true, "jam": "Although this one takes awhile to get going and the \"Spreadsheet\" recording doesn't do it justice, Trey trills like his life depends on it in the spectacular peak of the jam.", "nb": 1, "prev": "Lawn Boy", "next": "Horn"},
  {"date": "1999-12-30", "venue": "Big Cypress Seminole Indian Reservation", "city": "Big Cypress", "state": "FL", "gap": 2, "set": "1", "jamchart": true, "jam": "The wild Big Cypress version showcases some cool staccato playing (see also \"Plinko\") in the middle and an unusual jamming style, while still staying pretty close to the normal theme.", "nb": 1, "prev": "Corinna", "next": "Che Hun Ta Mo"},
  {"date": "2000-05-21", "venue": "Radio City Music Hall", "city": "New York", "state": "NY", "gap": 5, "set": "1", "out": ">", "nb": 1, "prev": "The Moma Dance", "in": ">", "next": "Character Zero"},
  {"date": "2000-06-10", "venue": "Zepp", "city": "Koto City", "state": "Tokyo", "gap": 3, "set": "e", "nb": 1, "prev": "The Inlaw Josie Wales", "last": 1},
  {"date": "2000-06-16", "venue": "Zepp", "city": "Suminoe Ward", "state": "Osaka", "gap": 4, "set": "1", "jamchart": true, "jam": "Great show opening version settles into a relaxed, groove-like section while retaining the \"LxL\" vibe. The jam then patiently builds to a shredding, celebratory conclusion.", "nb": 1, "first": 1, "next": "Back on the Train"},
  {"date": "2000-06-22", "venue": "AmSouth Amphitheatre", "city": "Antioch", "state": "TN", "gap": null, "set": "1", "jamchart": true, "jam": "Why many folks consider the \"LxL\" jam somewhat similar to The Grateful Dead's \"Crazy Fingers.\" Trey soars in this version.", "nb": 1, "prev": "Golgi Apparatus", "in": ">", "next": "Bug"},
  {"date": "2000-06-29", "venue": "PNC Bank Arts Center", "city": "Holmdel", "state": "NJ", "gap": 4, "set": "1", "jamchart": true, "jam": "Very solid with excellent playing by Trey. The intensity modulates up and down in the jam, with two enormous peaks.", "nb": 1, "prev": "Wilson", "next": "Drowned"},
  {"date": "2000-07-06", "venue": "Molson Amphitheatre", "city": "Toronto", "state": "Ontario", "gap": 4, "set": "2", "jamchart": true, "jam": "Jam departs somewhat from the typical direction, but is interesting and well-played. Unfinished with transition to \"2001.\"", "note": "Unfinished.", "out": ">", "nb": 1, "xprev": "You Enjoy Myself", "next": "Also Sprach Zarathustra"},
