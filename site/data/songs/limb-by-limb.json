  {"date": "1997-06-22", "venue": "Loreley", "city": "St. Goarshausen", "state": "Rhineland-Palatinate", "gap": null, "set": "e", "nb": 1, "xprev": "Ghost", "last": 1},
  {"date": "1997-06-25", "venue": "L\u2019Aeronef", "city": "Lille", "state": "Hauts-de-France", "gap": 1, "set": "1", "nb": 1, "prev": "Saw It Again", "next": "My Soul"},
  {"date": "1997-07-01", "venue": "Paradiso", "city": "Amsterdam", "state": "North Holland", "gap": 2, "set": "1", "jamchart": true, "jam": "Two weeks into its life, the band has got this song nearly nailed. This version is very well played and includes a delicate, almost silent coda that leads to a -> to \"Ain't Love Funny.\"", "out": "->", "nb": 1, "prev": "Ya Mar", "next": "Ain't Love Funny"},
  {"date": "1997-07-10", "venue": "Espace Julien", "city": "Marseilles", "state": "PACA", "gap": 5, "set": "1", "nb": 1, "prev": "Dogs Stole Things", "next": "Ginseng Sullivan"},
  {"date": "1997-07-23", "venue": "Lakewood Amphitheatre", "city": "Atlanta", "state": "GA", "gap": 3, "set": "1", "jamchart": true, "jam": "An excellent version which showcases the dynamic interplay between Trey and Page, while Fish and Mike keep the intricate rhythmic pattern steady throughout. Also has a fantastic peak and gradual settle.", "nb": 1, "prev": "Water in the Sky", "next": "Split Open and Melt"},
  {"date": "1997-07-26", "venue": "South Park Meadows", "city": "Austin", "state": "TX", "gap": 1, "set": "1", "jamchart": true, "jam": "In addition to hosting Bob Gullotti on a second drum set, the boys bust out the Funk towards the end of this version - an extremely rare style for a \"Limb\" jam.", "note": "Bob Gullotti on a second drum set.", "nb": 1, "first": 1, "next": "Dogs Stole Things"},
  {"date": "1997-07-31", "venue": "Shoreline Amphitheatre", "city": "Mountain View", "state": "CA", "gap": 2, "set": "1", "jamchart": true, "jam": "Band-wide cohesion on display here, as all four deftly contribute to this complex and well-played version.", "nb": 1, "prev": "Dogs Stole Things", "next": "Dirt"},
  {"date": "1997-08-03", "venue": "Gorge Amphitheatre", "city": "George", "state": "WA", "gap": 1, "set": "1", "jamchart": true, "jam": "A very different version from 7/31/97, with more staccato playing by Trey, and minor key fills from Page at points.", "nb": 1, "prev": "Jesus Just Left Chicago", "next": "Character Zero"},
  {"date": "1997-08-08", "venue": "New World Music Theatre", "city": "Tinley Park", "state": "IL", "gap": 1, "set": "2", "jamchart": true, "jam": "In addition to (typically '97) adept playing, this version also has a cool build to the big peak, starting at about 7:40.", "nb": 1, "prev": "Free", "next": "Loving Cup"},
  {"date": "1997-08-11", "venue": "Deer Creek Music Center", "city": "Noblesville", "state": "IN", "gap": 2, "set": "1", "nb": 1, "prev": "Guelah Papyrus", "next": "Horn"},
  {"date": "1997-08-14", "venue": "Darien Lake Performing Arts Center", "city": "Darien Center", "state": "NY", "gap": 1, "set": "1", "nb": 1, "prev": "Fluffhead", "next": "Free"},
  {"date": "1997-08-16", "venue": "Loring Commerce Centre", "city": "Limestone", "state": "ME", "gap": null, "set": "3", "jamchart": true, "jam": "The boys really stretch the jam out on this one nicely, and the playing is excellent. They also tack on a nice extended ending (was played near the end of day 1 of the Great Went) before transitioning to \"Funky Bitch.\"", "out": ">", "nb": 1, "prev": "Lawn Boy", "next": "Funky Bitch"},
  {"date": "1997-11-19", "venue": "Assembly Hall, University of Illinois", "city": "Champaign", "state": "IL", "gap": 5, "set": "1", "nb": 1, "prev": "Dirt", "next": "Funky Bitch"},
  {"date": "1997-11-28", "venue": "Worcester Centrum Centre", "city": "Worcester", "state": "MA", "gap": 4, "set": "2", "jamchart": true, "jam": "Like driving across a mountain range, this version takes you over the first peak, you drop down a bit, then back up again, and again up over the very top, before finally heading down for good on the other side.", "nb": 1, "prev": "Timber (Jerry the Mule)", "in": ">", "next": "Slave to the Traffic Light"},
  {"date": "1997-12-05", "venue": "CSU Convocation Center", "city": "Cleveland", "state": "OH", "gap": 4, "set": "1", "jamchart": true, "jam": "The '97 \"Limbs\" were a great vintage, and this version is another excellent bottle well worth opening.", "out": ">", "nb": 1, "prev": "Ginseng Sullivan", "next": "Character Zero"},
  {"date": "1997-12-11", "venue": "Rochester War Memorial", "city": "Rochester", "state": "NY", "gap": 3, "set": "1", "jamchart": true, "jam": "Superlative even among the standouts. The best \"Limbs\" build to a peak that reaches the stratosphere, then gradually work back down to earth. Listen to this version for a prime example.", "nb": 1, "prev": "Dirt", "next": "Loving Cup"},
  {"date": "1997-12-31", "venue": "Madison Square Garden", "city": "New York", "state": "NY", "gap": 5, "set": "1", "nb": 1, "prev": "Wolfman's Brother", "next": "The Horse"},
  {"date": "1998-04-04", "venue": "Providence Civic Center", "city": "Providence", "state": "RI", "gap": 2, "set": "1", "nb": 1, "prev": "Ginseng Sullivan", "next": "Lawn Boy"},
  {"date": "1998-06-30", "venue": "The Grey Hall", "city": "Copenhagen", "state": "Capital Region", "gap": 1, "set": "1", "nb": 1, "first": 1, "next": "Ghost"},
  {"date": "1998-07-03", "venue": "Dyrskuepladsen", "city": "Ringe", "state": "Southern Denmark", "gap": 2, "set": "1", "nb": 1, "prev": "Down with Disease", "next": "Water in the Sky"},
  {"date": "1998-07-06", "venue": "Lucerna Theatre", "city": "Prague", "state": "Prague", "gap": 1, "set": "1", "nb": 1, "prev": "Cities", "next": "Train Song"},
  {"date": "1998-07-15", "venue": "Portland Meadows", "city": "Portland", "state": "OR", "gap": 3, "set": "2", "jamchart": true, "jam": "In addition to a stretched out, well-played jam, this version has a nice ambient closing that segues -> to \"Simple.\"", "out": "->", "nb": 1, "xprev": "Loving Cup", "next": "Simple"},
  {"date": "1998-07-19", "venue": "Shoreline Amphitheatre", "city": "Mountain View", "state": "CA", "gap": 2, "set": "1", "out": ">", "nb": 1, "prev": "Ghost", "in": ">", "next": "Roggae"},
  {"date": "1998-07-25", "venue": "South Park Meadows", "city": "Austin", "state": "TX", "gap": 3, "set": "2", "nb": 1, "prev": "When the Circus Comes", "in": ">", "next": "Fee"},
  {"date": "1998-08-03", "venue": "Deer Creek Music Center", "city": "Noblesville", "state": "IN", "gap": 6, "set": "2", "jamchart": true, "jam": "Fantastic version that has it all: delicate, intricate playing, a quiet tempered section that builds to a glorious peak, and then an orchestrated downshift concluding with serene, ambient space.", "nb": 1, "prev": "Axilla", "in": ">", "next": "Meat"},
  {"date": "1998-08-07", "venue": "Walnut Creek Amphitheater", "city": "Raleigh", "state": "NC", "gap": 1, "set": "2", "nb": 1, "prev": "Albuquerque", "in": ">", "next": "Wading in the Velvet Sea"},
  {"date": "1998-08-11", "venue": "Star Lake Amphitheatre", "city": "Burgettstown", "state": "PA", "gap": 2, "set": "2", "nb": 1, "prev": "Meat", "in": ">", "next": "When the Circus Comes"},
  {"date": "1998-08-15", "venue": "Loring Commerce Centre", "city": "Limestone", "state": "ME", "gap": 1, "set": "3", "jamchart": true, "jam": "1998 was also a strong year for \"Limb.\" This Lemonwheel version is a case in point with a '98 style diminuendo ending.", "out": ">", "nb": 1, "prev": "Strange Design", "next": "Brian and Robert"},
  {"date": "1998-10-15", "venue": "The Fillmore", "city": "San Francisco", "state": "CA", "gap": 2, "set": "e", "nb": 1, "prev": "Dirt", "last": 1},
  {"date": "1998-10-29", "venue": "Greek Theatre", "city": "Los Angeles", "state": "CA", "gap": 3, "set": "1", "nb": 1, "prev": "Llama", "next": "Driver"},
  {"date": "1998-11-02", "venue": "The \u201cE\u201d Center", "city": "West Valley City", "state": "UT", "gap": 2, "set": "1", "jamchart": true, "jam": "Beautiful, serene playing. At about 8:00, the jam amps down into delicate, contemplative playing.", "nb": 1, "prev": "Bittersweet Motel", "next": "Wading in the Velvet Sea"},
  {"date": "1998-11-07", "venue": "UIC Pavilion, University of Illinois", "city": "Chicago", "state": "IL", "gap": 2, "set": "1", "nb": 1, "prev": "The Wedge", "next": "Fikus"},
  {"date": "1998-11-11", "venue": "Van Andel Arena", "city": "Grand Rapids", "state": "MI", "gap": 2, "set": "2", "jamchart": true, "jam": "Page solos in the middle of the jam, and then the others gradually join back in to build to a high peak.", "nb": 1, "prev": "Walk Away", "in": ">", "next": "When the Circus Comes"},
  {"date": "1998-11-15", "venue": "Murphy Center, Middle Tennessee State University", "city": "Murfreesboro", "state": "TN", "gap": 2, "set": "1", "jamchart": true, "jam": "Awesome guitar, great rhythm/piano/guitar interplay, and steady, solid bass back-up playing.", "nb": 1, "prev": "Cavern", "in": ">", "next": "Roggae"},
  {"date": "1998-11-24", "venue": "New Haven Veterans Memorial Coliseum", "city": "New Haven", "state": "CT", "gap": 4, "set": "1", "nb": 1, "prev": "Brian and Robert", "next": "Sample in a Jar"},
  {"date": "1998-11-29", "venue": "Worcester Centrum Centre", "city": "Worcester", "state": "MA", "gap": 3, "set": "1", "jamchart": true, "jam": "Fierce version that ends with a very cool jam and masterful segue into \"Catapult.\"", "out": "->", "nb": 1, "prev": "Horn", "in": ">", "next": "Catapult"},
  {"date": "1998-12-29", "venue": "Madison Square Garden", "city": "New York", "state": "NY", "gap": 1, "set": "2", "jamchart": true, "jam": "Page in particular shines brightly (but also Trey) in this strong, full-powered version. Segues to a stellar \"2001.\"", "out": ">", "nb": 1, "prev": "Free", "in": ">", "next": "Also Sprach Zarathustra"},
  {"date": "1999-06-30", "venue": "Sandstone Amphitheatre", "city": "Bonner Springs", "state": "KS", "gap": 2, "set": "1", "jamchart": true, "jam": "A different vibe to this version, it has a subdued, almost melancholy quality to it despite being well played. An unusual take on \"Limb\" and worth checking out.", "nb": 1, "prev": "Maze", "next": "Golgi Apparatus"},
  {"date": "1999-07-09", "venue": "Merriweather Post Pavilion", "city": "Columbia", "state": "MD", "gap": 5, "set": "1", "nb": 1, "first": 1, "next": "Farmhouse"},
