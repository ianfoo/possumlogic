  {"date": "2015-07-22", "venue": "Les Schwab Amphitheater", "city": "Bend", "state": "OR", "gap": 4, "set": "1", "jamchart": true, "jam": "This version has a relaxed, feel-good vibe that's one part \"Gin,\" one part \"LxL,\" and four parts Phish. Eventually peaking in a strong manner, the closing adds appropriate punctuation.", "prev": "How Many People Are You", "next": "Heavy Rotation", "nb": 1},
